<Window x:Class="GitGui.App.Views.FileActionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GitGui.App.Localization"
 Title="{Binding Title}" Width="680" Height="480" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Icon="/Shovel;component/Assets/Shovel.ico" FlowDirection="{x:Static loc:UiText.Direction}" Background="{DynamicResource Theme.Panel}" Foreground="{DynamicResource Theme.Text}">
 <Grid Margin="16" Background="{DynamicResource Theme.Panel}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <ListBox Grid.Row="1" ItemsSource="{Binding Targets}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Text Key=FileActionTargets}">
   <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="3,4"/></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="2" x:Name="MessagePanel" Margin="0,12,0,0"><Label Content="{loc:Text Key=StashMessage}" Target="{Binding ElementName=MessageBox}"/>
   <TextBox x:Name="MessageBox" MaxLength="4096" AutomationProperties.Name="{loc:Text Key=StashMessage}"/>
  </StackPanel>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="{Binding AcceptLabel}" Click="OnAccept" MinWidth="100" Margin="0,0,8,0"/>
   <Button Content="{loc:Text Key=ActionCancel}" IsCancel="True" IsDefault="True" MinWidth="90"/>
  </StackPanel>
 </Grid>
</Window>
