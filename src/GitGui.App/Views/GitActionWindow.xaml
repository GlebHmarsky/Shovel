<Window x:Class="GitGui.App.Views.GitActionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GitGui.App.Localization" Title="{Binding Title}" Width="650" Height="560" MinWidth="520" MinHeight="480"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" FlowDirection="{x:Static loc:UiText.Direction}"
 Background="{DynamicResource Theme.Sidebar}" Foreground="{DynamicResource Theme.Text}"
 FontFamily="Segoe UI" FontSize="13">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/></Window.Resources>
 <Border Background="{DynamicResource Theme.Sidebar}"><Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,8"/>
   <TextBlock Text="{Binding CurrentRepository}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentRepository}" FlowDirection="LeftToRight"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12">
   <StackPanel IsEnabled="{Binding CanEdit}">
    <StackPanel Visibility="{Binding IsNew, Converter={StaticResource Visible}}">
     <Label Content="{loc:Text Key=ActionBranchNameLabel}" Target="{Binding ElementName=NewName}"/><TextBox x:Name="NewName" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Text Key=ActionBranchNameLabel}"/>
     <Label Content="{loc:Text Key=ActionStart}"/><ComboBox ItemsSource="{Binding StartRefs}" SelectedItem="{Binding StartRef}" AutomationProperties.Name="{loc:Text Key=ActionStart}"/>
     <CheckBox Content="{loc:Text Key=ActionCheckout}" IsChecked="{Binding Checkout}" Margin="0,10"/>
    </StackPanel>
    <StackPanel Visibility="{Binding ChooseBranch, Converter={StaticResource Visible}}"><Label Content="{loc:Text Key=ActionBranchLabel}"/><ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding Branch}" AutomationProperties.Name="{loc:Text Key=ActionBranchLabel}"/></StackPanel>
    <StackPanel Visibility="{Binding IsNetwork, Converter={StaticResource Visible}}"><Label Content="{loc:Text Key=ActionRemote}"/><ComboBox ItemsSource="{Binding Remotes}" SelectedItem="{Binding Remote}" DisplayMemberPath="Name" AutomationProperties.Name="{loc:Text Key=ActionRemote}"/>
     <TextBlock Text="{Binding Target}" TextWrapping="Wrap" Margin="0,6" FlowDirection="LeftToRight"/>
    </StackPanel>
    <StackPanel Visibility="{Binding ChooseRemoteBranch, Converter={StaticResource Visible}}"><Label Content="{loc:Text Key=ActionRemoteBranch}"/><ComboBox IsEditable="True" ItemsSource="{Binding RemoteBranches}" Text="{Binding RemoteBranch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Text Key=ActionRemoteBranch}"/></StackPanel>
    <StackPanel Visibility="{Binding IsPull, Converter={StaticResource Visible}}" Margin="0,8">
     <TextBlock Text="{Binding Into, StringFormat={loc:Text Key=ActionInto}}"/>
     <RadioButton Content="{loc:Text Key=ActionPullRebase}" IsChecked="{Binding Rebase}" GroupName="PullStrategy" Margin="0,10,0,0"/>
     <RadioButton Content="{loc:Text Key=ActionPullMerge}" IsChecked="{Binding Merge}" GroupName="PullStrategy" Margin="0,6"/>
     <TextBlock Text="{loc:Text Key=ActionPullStrategyHelp}" TextWrapping="Wrap"/>
     <CheckBox Content="{loc:Text Key=ActionAutoStash}" IsChecked="{Binding AutoStash}" Margin="0,10,0,4"/>
     <TextBlock Text="{loc:Text Key=ActionAutoStashHelp}" TextWrapping="Wrap"/>
    </StackPanel>
    <CheckBox Content="{loc:Text Key=ActionAllRemotes}" IsChecked="{Binding AllRemotes}" Visibility="{Binding IsFetch, Converter={StaticResource Visible}}" Margin="0,8"/>
    <StackPanel Visibility="{Binding IsPush, Converter={StaticResource Visible}}" Margin="0,8">
     <CheckBox Content="{loc:Text Key=ActionAllTags}" IsChecked="{Binding AllTags}"/><CheckBox Content="{loc:Text Key=ActionSetUpstream}" IsChecked="{Binding SetUpstream}" Margin="0,8"/>
    </StackPanel>
    <Expander Header="{loc:Text Key=ActionAuthentication}" Margin="0,12" Visibility="{Binding IsNetwork, Converter={StaticResource Visible}}">
     <TextBlock Text="{loc:Text Key=ActionAuthLimits}" TextWrapping="Wrap" Margin="0,8"/>
    </Expander>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
   <Button Content="{Binding Title}" Command="{Binding RunCommand}" MinWidth="90" Padding="12,6" IsDefault="True"
           ToolTip="{Binding RunUnavailableReason}" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding RunUnavailableReason}"/>
   <Button Content="{loc:Text Key=ActionCancel}" Click="OnCancel" MinWidth="90" Padding="12,6" Margin="10,0,0,0"/>
  </StackPanel>
 </Grid></Border>
</Window>
