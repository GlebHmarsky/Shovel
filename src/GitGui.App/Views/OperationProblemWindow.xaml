<Window x:Class="GitGui.App.Views.OperationProblemWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GitGui.App.Localization" Title="{loc:Text Key=OperationAttentionTitle}"
 Width="840" Height="520" MinWidth="560" MinHeight="320" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{DynamicResource Theme.Sidebar}" Foreground="{DynamicResource Theme.Text}" FontFamily="Segoe UI" FontSize="13">
 <Grid Margin="18" Background="{DynamicResource Theme.Sidebar}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
  <TextBlock Grid.Row="1" Text="{Binding Repository}" Margin="0,6" TextTrimming="CharacterEllipsis" ToolTip="{Binding Repository}"/>
  <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="0,6,0,12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
  <TextBox Grid.Row="3" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Text Key=OperationAttentionLogs}"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="{loc:Text Key=ReopenCommit}" Click="OnReopen" Margin="0,0,8,0">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanReopen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
   </Button>
   <Button Content="{loc:Text Key=OperationAttentionDismiss}" IsDefault="True" IsCancel="True" Click="OnDismiss" MinWidth="100"/>
  </StackPanel>
 </Grid>
</Window>
