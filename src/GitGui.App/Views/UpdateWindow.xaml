<Window x:Class="GitGui.App.Views.UpdateWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GitGui.App.Localization" Title="{loc:Text Key=UpdateTitle}" Width="620" Height="570" MinWidth="520" MinHeight="500" WindowStartupLocation="CenterOwner">
 <Grid Margin="18" Background="{DynamicResource Theme.Panel}" TextElement.Foreground="{DynamicResource Theme.Text}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="{loc:Text Key=UpdateInstalledLabel}"/><TextBlock Text="{Binding InstalledVersion}" FontSize="18" Margin="0,4,0,8"/></StackPanel>
 <StackPanel Grid.Row="1"><TextBlock Text="{Binding Endpoint}" TextWrapping="Wrap"/><TextBlock Text="{Binding Channel}" Margin="0,4,0,8"/><TextBlock Text="{loc:Text Key=UpdatePrivacy}" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Muted}"/></StackPanel>
 <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12" AutomationProperties.LiveSetting="Polite"/>
 <CheckBox Grid.Row="3" Content="{loc:Text Key=UpdatePeriodic}" IsChecked="{Binding PeriodicChecks}" Margin="0,0,0,12"/>
 <TextBox Grid.Row="4" Text="{Binding Notes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Text Key=UpdateNotes}"/>
 <WrapPanel Grid.Row="5" HorizontalAlignment="Right" Margin="0,14,0,0">
 <Button Content="{loc:Text Key=UpdateCheck}" Command="{Binding CheckCommand}" Margin="0,0,8,0"/>
 <Button Content="{loc:Text Key=UpdateCancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
 <Button Content="{loc:Text Key=UpdateRestart}" Command="{Binding RestartCommand}" Margin="0,0,8,0"/>
 <Button Content="{loc:Text Key=UpdateClose}" IsCancel="True"/>
 </WrapPanel></Grid>
</Window>
