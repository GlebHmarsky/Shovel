<Window x:Class="GitGui.App.Views.RepositoryInitWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GitGui.App.Localization" Title="{loc:Text Key=ActionTitleInit}"
 Width="620" Height="410" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 FlowDirection="{x:Static loc:UiText.Direction}" FontFamily="Segoe UI" FontSize="13"
 Background="{DynamicResource Theme.Sidebar}" Foreground="{DynamicResource Theme.Text}">
 <Border Background="{DynamicResource Theme.Sidebar}"><Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock Text="{loc:Text Key=ActionTitleInit}" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="{loc:Text Key=ActionExplainInit}" TextWrapping="Wrap" Margin="0,8,0,12"/>
    <Label Content="{loc:Text Key=InitDirectory}" Target="{Binding ElementName=DirectoryInput}"/>
    <DockPanel><Button DockPanel.Dock="Right" Content="{loc:Text Key=InitBrowse}" Command="{Binding BrowseCommand}" Margin="8,0,0,0"/>
     <TextBox x:Name="DirectoryInput" Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Text Key=InitDirectory}"/></DockPanel>
    <Label Content="{loc:Text Key=InitBranch}" Target="{Binding ElementName=BranchInput}" Margin="0,10,0,0"/>
    <TextBox x:Name="BranchInput" Text="{Binding InitialBranch, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Text Key=InitBranch}"/>
    <TextBlock Text="{loc:Text Key=InitBranchHelp}" TextWrapping="Wrap" Margin="0,6,0,12"/>
    <TextBlock Text="{Binding Readiness}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="{loc:Text Key=InitCreate}" Command="{Binding CreateCommand}" ToolTip="{Binding Readiness}" ToolTipService.ShowOnDisabled="True" IsDefault="True" MinWidth="85"/>
   <Button Content="{loc:Text Key=ActionCancel}" IsCancel="True" MinWidth="85" Margin="8,0,0,0"/>
  </StackPanel>
 </Grid></Border>
</Window>
