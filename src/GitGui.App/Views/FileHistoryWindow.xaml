<Window x:Class="GitGui.App.Views.FileHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GitGui.App.Localization" xmlns:views="clr-namespace:GitGui.App.Views"
 Title="{Binding Title}" Width="1200" Height="800" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Icon="/Shovel;component/Assets/Shovel.ico" FlowDirection="{x:Static loc:UiText.Direction}" Background="{DynamicResource Theme.Panel}" Foreground="{DynamicResource Theme.Text}">
 <Window.Resources><Style x:Key="Rows" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
  <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
  <Setter Property="CanUserSortColumns" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/>
  <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
 </Style></Window.Resources>
 <DockPanel Margin="10" Background="{DynamicResource Theme.Panel}">
  <TextBlock DockPanel.Dock="Top" Text="{Binding Scope}" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
   <Button Content="{loc:Text Key=ActionCancel}" Command="{Binding CancelCommand}" Margin="8,0"/><Button Content="{loc:Text Key=RefreshRepository}" Command="{Binding RefreshCommand}"/>
  </StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></DockPanel>
  <Expander DockPanel.Dock="Bottom" Header="{loc:Text Key=ActionOutput}"><TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" MaxHeight="100" VerticalScrollBarVisibility="Auto"/></Expander>
  <TabControl SelectedIndex="{Binding Mode}">
   <TabItem Header="{loc:Text Key=FileHistoryTab}"><Grid><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="100"/><RowDefinition Height="4"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
    <DataGrid Style="{StaticResource Rows}" ItemsSource="{Binding History}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{loc:Text Key=FileHistoryTab}">
     <DataGrid.Columns><DataGridTextColumn Header="{loc:Text Key=HistoryDescription}" Binding="{Binding Subject}" Width="*"/>
      <DataGridTextColumn Header="{loc:Text Key=HistoryAuthor}" Binding="{Binding Author}" Width="160"/><DataGridTextColumn Header="{loc:Text Key=HistoryDate}" Binding="{Binding Date}" Width="160"/><DataGridTextColumn Header="{loc:Text Key=HistoryHash}" Binding="{Binding Hash}" Width="90"/>
     </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="1" Margin="4"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{loc:Text Key=FileHistoryFirst}" Command="{Binding FirstCommand}"/><Button Content="{loc:Text Key=FileHistoryNewer}" Command="{Binding NewerCommand}"/><Button Content="{loc:Text Key=FileHistoryOlder}" Command="{Binding OlderCommand}"/></StackPanel><TextBlock Text="{Binding Page}" VerticalAlignment="Center"/></DockPanel>
    <TextBox Grid.Row="2" Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Text Key=FileHistoryMetadata}"/>
    <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource Theme.Border}" AutomationProperties.Name="{loc:Text Key=CommitResizeMessage}"/>
    <views:CommitFilesView Grid.Row="4" DataContext="{Binding Files}"/>
   </Grid></TabItem>
   <TabItem Header="{loc:Text Key=FileBlameTab}"><DataGrid Style="{StaticResource Rows}" ItemsSource="{Binding Blame}" AutomationProperties.Name="{loc:Text Key=FileBlameTab}">
    <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="ToolTip" Value="{Binding Help}"/><Setter Property="AutomationProperties.HelpText" Value="{Binding Help}"/></Style></DataGrid.RowStyle>
    <DataGrid.Columns><DataGridTextColumn Header="{loc:Text Key=FileBlameLine}" Binding="{Binding Number}" Width="55"/><DataGridTextColumn Header="{loc:Text Key=HistoryHash}" Binding="{Binding Hash}" Width="85"/>
     <DataGridTextColumn Header="{loc:Text Key=HistoryAuthor}" Binding="{Binding Author}" Width="140"/><DataGridTextColumn Header="{loc:Text Key=HistoryDate}" Binding="{Binding Date}" Width="150"/>
     <DataGridTextColumn Header="{loc:Text Key=FileBlameText}" Binding="{Binding Text}" Width="SizeToCells" MinWidth="400"/>
    </DataGrid.Columns>
   </DataGrid></TabItem>
  </TabControl>
 </DockPanel>
</Window>
