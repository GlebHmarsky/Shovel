<Window x:Class="GitGui.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GitGui.App.Localization"
        xmlns:views="clr-namespace:GitGui.App.Views"
        Title="{loc:Text Key=AppTitle}" Width="1200" Height="800" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" FlowDirection="{x:Static loc:UiText.Direction}"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        AutomationProperties.AutomationId="MainWindow">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="HistoryText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="{loc:Text Key=OpenRepository}" Command="{Binding OpenRepositoryCommand}" AutomationProperties.AutomationId="OpenRepository" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="{loc:Text Key=MoveLeft}" Command="{Binding MoveLeftCommand}" ToolTip="{loc:Text Key=MoveLeft}" />
          <Button Content="{loc:Text Key=MoveRight}" Command="{Binding MoveRightCommand}" ToolTip="{loc:Text Key=MoveRight}" />
          <Button Content="{loc:Text Key=CloseTab}" Command="{Binding CloseRepositoryCommand}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Repositories}" SelectedItem="{Binding SelectedRepository}" IsEnabled="{Binding CanNavigate}"
                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{loc:Text Key=RepositoryTabs}" AutomationProperties.AutomationId="RepositoryTabs">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Padding="8,5" ToolTip="{Binding Directory}" FlowDirection="LeftToRight" /></DataTemplate></ListBox.ItemTemplate>
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Label}" /></Style></ListBox.ItemContainerStyle>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Margin="12,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" ToolTip="{loc:Text Key=GitUnavailable}" ToolTipService.ShowOnDisabled="True">
        <Button Content="{loc:Text Key=Fetch}" IsEnabled="False" AutomationProperties.AutomationId="Fetch" />
        <Button Content="{loc:Text Key=Pull}" IsEnabled="False" />
        <Button Content="{loc:Text Key=Push}" IsEnabled="False" />
        <Button Content="{loc:Text Key=Stash}" IsEnabled="False" />
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="12,0">
        <TextBlock Text="{Binding RepositoryTitle}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding OperationStatus}" FontSize="11" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" ToolTip="{loc:Text Key=ToolsUnavailable}" ToolTipService.ShowOnDisabled="True">
        <Button Content="{loc:Text Key=Explorer}" IsEnabled="False" />
        <Button Content="{loc:Text Key=Terminal}" IsEnabled="False" />
        <Button Content="{loc:Text Key=Editor}" IsEnabled="False" />
        <Button Content="{loc:Text Key=Tools}" IsEnabled="False" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="2" Padding="16,8" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
      <TextBlock Text="{loc:Text Key=FoundationNotice}" TextWrapping="Wrap" />
    </Border>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="210" MinWidth="160" MaxWidth="320" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="500" />
      </Grid.ColumnDefinitions>
      <DockPanel Margin="10,14">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Text Key=Navigation}" FontWeight="SemiBold" Margin="8,0,0,12" />
        <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                 DisplayMemberPath="Label" BorderThickness="0" IsEnabled="{Binding CanNavigate}"
                 AutomationProperties.Name="{loc:Text Key=Navigation}" AutomationProperties.AutomationId="Navigation">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="8,9" />
              <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                    AutomationProperties.Name="{loc:Text Key=ResizeSidebar}" AutomationProperties.AutomationId="SidebarSplitter" />
      <Grid x:Name="WorkspacePanel" Grid.Column="2" SizeChanged="OnWorkspaceSizeChanged">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="HistoryRow" Height="*" MinHeight="300" />
          <RowDefinition Height="5" />
          <RowDefinition x:Name="DetailsRow" Height="180" MinHeight="80" MaxHeight="360" />
        </Grid.RowDefinitions>
        <Grid Margin="12,10,12,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,8">
            <ComboBox ItemsSource="{Binding HistoryScopes}" SelectedItem="{Binding SelectedHistoryScope}" DisplayMemberPath="Label"
                      IsEnabled="{Binding CanNavigate}" MinWidth="190" Margin="4,0,8,0" VerticalContentAlignment="Center"
                      ToolTip="{Binding HistoryScopeHelp}" AutomationProperties.HelpText="{Binding HistoryScopeHelp}"
                      AutomationProperties.Name="{loc:Text Key=HistoryScope}" AutomationProperties.AutomationId="HistoryScope" />
            <Button Content="{loc:Text Key=InspectRepository}" Command="{Binding RefreshRepositoryCommand}" AutomationProperties.AutomationId="RefreshRepository" />
            <Button Content="{loc:Text Key=CancelOperation}" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="CancelOperation" />
            <Button Content="{loc:Text Key=ChooseGit}" Command="{Binding ChooseGitCommand}" />
          </WrapPanel>
          <DockPanel Grid.Row="1" Margin="4,0,4,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding GitStatus}" Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center" />
            <StackPanel>
              <TextBlock Text="{Binding HistoryScopeDescription}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,5" Visibility="{Binding IsHistory, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock Text="{Binding SelectedRepository.Head, TargetNullValue={loc:Text Key=NoRepositorySelected}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedRepository.ReadAt}" />
              <TextBlock Text="{Binding SelectedRepository.State}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding SelectedRepository.HasOperation, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </DockPanel>
          <DataGrid Grid.Row="2" x:Name="HistoryTable" ItemsSource="{Binding Commits}" SelectedItem="{Binding SelectedCommit}"
                    Visibility="{Binding IsHistory, Converter={StaticResource BoolToVisibility}}"
                    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                    CanUserReorderColumns="False" CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                    HeadersVisibility="None" RowHeight="28" RowHeaderWidth="0" GridLinesVisibility="None" BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="{loc:Text Key=CommitHistoryTable}" AutomationProperties.AutomationId="CommitHistory">
            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityLabel}" /></Style></DataGrid.RowStyle>
            <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="AutomationProperties.HelpText" Value="{Binding Column.Header, RelativeSource={RelativeSource Self}}"/></Style></DataGrid.CellStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="{loc:Text Key=HistoryGraph}" Width="Auto" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <views:CommitGraphCell Row="{Binding Graph}" Width="{Binding DataContext.GraphWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                         IsSelected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" FlowDirection="LeftToRight" />
                </DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{loc:Text Key=HistoryDescription}" Width="*" MinWidth="300">
                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <DockPanel Margin="8,0" VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding RefPreview}" ToolTip="{Binding RefLabels}" FontWeight="SemiBold" MaxWidth="200" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="{loc:Text Key=HistoryAuthor}" Binding="{Binding Author}" Width="140" MinWidth="100" ElementStyle="{StaticResource HistoryText}" />
              <DataGridTextColumn Header="{loc:Text Key=HistoryDate}" Binding="{Binding Date}" Width="150" MinWidth="150" ElementStyle="{StaticResource HistoryText}" />
              <DataGridTextColumn Header="{loc:Text Key=HistoryHash}" Binding="{Binding ShortHash}" Width="115" MinWidth="115" ElementStyle="{StaticResource HistoryText}" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="2" Text="{loc:Text Key=SectionUnavailable}" Margin="8,12" TextWrapping="Wrap">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsHistory}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <StackPanel Grid.Row="3" Margin="4,6" Visibility="{Binding IsHistory, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:Text Key=NewerCommits}" Command="{Binding NewerHistoryCommand}" Margin="8,0,0,0" />
                <Button Content="{loc:Text Key=LoadOlderCommits}" Command="{Binding LoadMoreHistoryCommand}" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Text="{Binding HistoryRange}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
            <TextBlock Text="{Binding HistoryNotice}" TextWrapping="Wrap" FontSize="11" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{loc:Text Key=HistoryLimits}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" />
          </StackPanel>
        </Grid>
        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                      Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                      AutomationProperties.Name="{loc:Text Key=ResizeDetails}" AutomationProperties.AutomationId="DetailsSplitter" />
        <TabControl Grid.Row="2" Margin="12,8" AutomationProperties.Name="{loc:Text Key=Details}" AutomationProperties.AutomationId="DetailsTabs">
          <TabItem Header="{loc:Text Key=Commit}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14,10">
                <TextBlock Text="{Binding SelectedCommit.Description, TargetNullValue={loc:Text Key=SelectCommit}}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
                <TextBlock Text="{Binding SelectedCommit.RefLabels}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.Name="{loc:Text Key=CommitReferences}">
                  <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SelectedCommit.RefLabels}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{loc:Text Key=CommitMessage}" FontWeight="SemiBold" />
                <TextBox Text="{Binding SelectedCommit.MessagePreview, Mode=OneWay}" MaxHeight="220" VerticalScrollBarVisibility="Auto" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="{loc:Text Key=CommitMessage}" />
                <TextBlock Text="{Binding SelectedCommit.MessageNotice}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Text Key=HistoryAuthor}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox Text="{Binding SelectedCommit.AuthorDetails, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" AutomationProperties.Name="{loc:Text Key=HistoryAuthor}" />
                <TextBlock Text="{loc:Text Key=Committer}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox Text="{Binding SelectedCommit.CommitterDetails, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" AutomationProperties.Name="{loc:Text Key=Committer}" />
                <TextBlock Text="{loc:Text Key=HistoryHash}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox Text="{Binding SelectedCommit.Commit.Hash, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Text Key=HistoryHash}" />
                <TextBlock Text="{loc:Text Key=CommitParents}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox Text="{Binding SelectedCommit.Parents, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" FlowDirection="LeftToRight" TextWrapping="Wrap" AutomationProperties.Name="{loc:Text Key=CommitParents}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{loc:Text Key=RepositoryDetails}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="16">
                <TextBlock Text="{Binding SelectedRepository.State}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding SelectedRepository.ReadAt}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{loc:Text Key=RepositoryPath}" FontWeight="SemiBold" />
                <TextBox Text="{Binding SelectedRepository.Directory, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" FlowDirection="LeftToRight" TextWrapping="Wrap" AutomationProperties.Name="{loc:Text Key=RepositoryPath}" />
                <TextBlock Text="{loc:Text Key=WorktreePath}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox Text="{Binding SelectedRepository.Snapshot.Worktree, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" FlowDirection="LeftToRight" TextWrapping="Wrap" AutomationProperties.Name="{loc:Text Key=WorktreePath}" />
                <TextBlock Text="{loc:Text Key=CommonDirectory}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox Text="{Binding SelectedRepository.Snapshot.CommonDirectory, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" FlowDirection="LeftToRight" TextWrapping="Wrap" AutomationProperties.Name="{loc:Text Key=CommonDirectory}" />
                <TextBlock Text="{loc:Text Key=HeadCommit}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox Text="{Binding SelectedRepository.Snapshot.Commit, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" FlowDirection="LeftToRight" TextWrapping="Wrap" AutomationProperties.Name="{loc:Text Key=HeadCommit}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{loc:Text Key=RawOutput}"><TextBox Text="{Binding RawOutput, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Text Key=RawOutput}" /></TabItem>
          <TabItem Header="{loc:Text Key=ChangedFiles}"><TextBlock Text="{loc:Text Key=FilesEmpty}" Margin="16" TextWrapping="Wrap" /></TabItem>
          <TabItem Header="{loc:Text Key=Diff}"><TextBlock Text="{loc:Text Key=DiffEmpty}" Margin="16" TextWrapping="Wrap" /></TabItem>
          <TabItem Header="{loc:Text Key=FileTree}"><TextBlock Text="{loc:Text Key=TreeEmpty}" Margin="16" TextWrapping="Wrap" /></TabItem>
        </TabControl>
      </Grid>
    </Grid>
    <Border Grid.Row="4" Padding="14,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" Margin="16,0,0,0" FlowDirection="LeftToRight" />
        <StackPanel>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="Status" />
          <TextBlock Text="{Binding SettingsNotice}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
