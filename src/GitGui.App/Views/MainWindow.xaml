<Window x:Class="GitGui.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GitGui.App.Localization"
        xmlns:views="clr-namespace:GitGui.App.Views"
        Title="{loc:Text Key=AppTitle}" Width="1200" Height="800" MinWidth="900" MinHeight="620"
        Icon="/Shovel;component/Assets/Shovel.ico"
        WindowStartupLocation="CenterScreen" FlowDirection="{x:Static loc:UiText.Direction}"
        Background="{DynamicResource Theme.Chrome}"
        Foreground="{DynamicResource Theme.Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        AutomationProperties.AutomationId="MainWindow">
  <Window.Resources>
    <Style x:Key="AuthorHighlightText" TargetType="TextBlock">
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsSameAuthor}" Value="True" />
            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="False" />
            <Condition Binding="{Binding HighContrast, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Foreground" Value="{DynamicResource Theme.AuthorPeer}" />
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" /><Setter Property="Padding" Value="7,4" /><Setter Property="Margin" Value="2,0" />
      <Setter Property="MinWidth" Value="48" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="ToolbarIcon" TargetType="Path">
      <Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /><Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      <Setter Property="StrokeThickness" Value="1.5" /><Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="HistoryText" TargetType="TextBlock" BasedOn="{StaticResource AuthorHighlightText}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource Theme.Chrome}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Menu AutomationProperties.Name="{loc:Text Key=MainMenu}">
      <MenuItem Header="{loc:Text Key=FileMenu}">
        <MenuItem Header="{loc:Text Key=OpenRepository}" Command="{Binding OpenRepositoryCommand}" />
        <MenuItem Header="{loc:Text Key=CloseTab}" Command="{Binding CloseRepositoryCommand}" />
      </MenuItem>
      <MenuItem Header="{loc:Text Key=ViewMenu}">
        <MenuItem Header="{loc:Text Key=FirstHistoryPage}" Command="{Binding FirstHistoryCommand}" />
        <MenuItem Header="{loc:Text Key=Diagnostics}" Command="{Binding DiagnosticsCommand}" />
      </MenuItem>
      <MenuItem Header="{loc:Text Key=RepositoryMenu}">
        <MenuItem Header="{loc:Text Key=OpenRepository}" Command="{Binding OpenRepositoryCommand}" />
        <MenuItem Header="{loc:Text Key=RefreshRepository}" Command="{Binding RefreshRepositoryCommand}" />
        <MenuItem Header="{loc:Text Key=CancelOperation}" Command="{Binding CancelCommand}" />
        <MenuItem Header="{loc:Text Key=FirstHistoryPage}" Command="{Binding FirstHistoryCommand}" />
        <Separator />
        <MenuItem Header="{loc:Text Key=ChooseGit}" Command="{Binding ChooseGitCommand}" />
        <MenuItem Header="{loc:Text Key=Diagnostics}" Command="{Binding DiagnosticsCommand}" />
        <Separator />
        <MenuItem Header="{loc:Text Key=MoveLeft}" Command="{Binding MoveLeftCommand}" />
        <MenuItem Header="{loc:Text Key=MoveRight}" Command="{Binding MoveRightCommand}" />
        <MenuItem Header="{loc:Text Key=CloseTab}" Command="{Binding CloseRepositoryCommand}" />
      </MenuItem>
      <MenuItem Header="{loc:Text Key=WindowMenu}">
        <MenuItem Header="{loc:Text Key=MoveLeft}" Command="{Binding MoveLeftCommand}" />
        <MenuItem Header="{loc:Text Key=MoveRight}" Command="{Binding MoveRightCommand}" />
        <MenuItem Header="{loc:Text Key=CloseTab}" Command="{Binding CloseRepositoryCommand}" />
      </MenuItem>
      <MenuItem Header="{loc:Text Key=HelpMenu}">
        <MenuItem Header="{Binding Version}" IsEnabled="False" />
        <MenuItem Header="{loc:Text Key=Diagnostics}" Command="{Binding DiagnosticsCommand}" />
      </MenuItem>
    </Menu>
    <ListBox Grid.Row="2" ItemsSource="{Binding Repositories}" SelectedItem="{Binding SelectedRepository}" IsEnabled="{Binding CanNavigate}"
             BorderThickness="0,0,0,1" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
             AutomationProperties.Name="{loc:Text Key=RepositoryTabs}" AutomationProperties.AutomationId="RepositoryTabs">
      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Padding="12,8" ToolTip="{Binding Directory}" FlowDirection="LeftToRight" /></DataTemplate></ListBox.ItemTemplate>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
          <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
          <EventSetter Event="PreviewMouseDown" Handler="OnRepositoryTabMouseDown" />
          <Setter Property="ContextMenu">
            <Setter.Value>
              <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.Name="{loc:Text Key=RepositoryTabMenu}">
                <MenuItem Header="{loc:Text Key=RefreshRepository}" Command="{Binding RefreshTabCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Separator />
                <MenuItem Header="{loc:Text Key=MoveLeft}" Command="{Binding MoveTabLeftCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="{loc:Text Key=MoveRight}" Command="{Binding MoveTabRightCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Separator />
                <MenuItem Header="{loc:Text Key=CloseTab}" Command="{Binding CloseTabCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="{loc:Text Key=CloseOtherTabs}" Command="{Binding CloseOtherTabsCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              </ContextMenu>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
    </ListBox>
    <Grid Grid.Row="1" Margin="8,4" AutomationProperties.Name="{loc:Text Key=RepositoryActions}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenRepositoryCommand}" AutomationProperties.Name="{loc:Text Key=OpenRepository}">
          <StackPanel><Path Style="{StaticResource ToolbarIcon}" Data="M1,4 L7,4 9,6 19,6 19,17 1,17 Z"/><TextBlock Text="{loc:Text Key=OpenRepository}"/></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ShowChangesCommand}" ToolTip="{loc:Text Key=CommitOpenHelp}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding CommitButtonLabel}">
          <StackPanel><Path Style="{StaticResource ToolbarIcon}" Data="M2,10 L7,15 18,3"/><TextBlock Text="{Binding CommitButtonLabel}"/></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolbarButton}" Command="{Binding FetchCommand}" ToolTip="{Binding FetchActionHelp}" AutomationProperties.HelpText="{Binding FetchActionHelp}" AutomationProperties.Name="{loc:Text Key=Fetch}">
          <StackPanel><Path Style="{StaticResource ToolbarIcon}" Data="M10,1 L10,14 M5,9 L10,14 15,9 M2,16 L2,20 18,20 18,16"/><TextBlock Text="{loc:Text Key=Fetch}"/></StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" ToolTip="{Binding DivergenceHelp}">
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding PullCommand}" AutomationProperties.Name="{loc:Text Key=Pull}" ToolTip="{Binding PullActionHelp}" AutomationProperties.HelpText="{Binding PullActionHelp}">
            <StackPanel><Path Style="{StaticResource ToolbarIcon}" Data="M17,2 C5,2 5,5 5,16 M1,11 L5,16 10,11"/><TextBlock Text="{loc:Text Key=Pull}"/></StackPanel>
          </Button>
          <TextBlock Text="{Binding PullCount}" VerticalAlignment="Top" Margin="0,5,5,0" FontWeight="SemiBold" AutomationProperties.Name="{loc:Text Key=BehindCount}" AutomationProperties.HelpText="{Binding DivergenceHelp}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" ToolTip="{Binding DivergenceHelp}">
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding PushCommand}" AutomationProperties.Name="{loc:Text Key=Push}" ToolTip="{Binding PushActionHelp}" AutomationProperties.HelpText="{Binding PushActionHelp}">
            <StackPanel><Path Style="{StaticResource ToolbarIcon}" Data="M3,18 C15,18 15,15 15,4 M10,9 L15,4 19,9"/><TextBlock Text="{loc:Text Key=Push}"/></StackPanel>
          </Button>
          <TextBlock Text="{Binding PushCount}" VerticalAlignment="Top" Margin="0,5,5,0" FontWeight="SemiBold" AutomationProperties.Name="{loc:Text Key=AheadCount}" AutomationProperties.HelpText="{Binding DivergenceHelp}" />
        </StackPanel>
      </StackPanel>
      <Grid Grid.Column="1" MaxWidth="530"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Margin="12,0" Padding="10,4" MaxWidth="430" Background="{DynamicResource Theme.Raised}" CornerRadius="3">
        <StackPanel HorizontalAlignment="Stretch">
          <TextBlock Text="{Binding RepositoryTitle}" TextAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedRepository.Directory}" />
          <TextBlock Text="{Binding SelectedRepository.Head, TargetNullValue={loc:Text Key=NoRepositorySelected}}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip="{Binding SelectedRepository.Head}" />
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}">
              <Button Content="{loc:Text Key=ActionDetails}" Command="{Binding ShowActionDetailsCommand}" Padding="3,0" Margin="3,0" FontSize="11" BorderThickness="0" Background="Transparent" AutomationProperties.Name="{loc:Text Key=ActionDetails}" />
              <Button Content="{loc:Text Key=ActionCancel}" Command="{Binding CancelCommand}" Padding="3,0" FontSize="11" BorderThickness="0" Background="Transparent" Visibility="{Binding IsActionRunning, Converter={StaticResource BoolToVisibility}}" ToolTip="{loc:Text Key=ActionCancelHelp}" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{loc:Text Key=ActionCancelHelp}" />
            </StackPanel>
            <TextBlock Text="{Binding OperationStatus}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" ToolTip="{Binding OperationStatus}" AutomationProperties.AutomationId="OperationStatus" AutomationProperties.LiveSetting="Polite" />
          </DockPanel>
          <ProgressBar Height="3" Margin="0,2,0,0" IsIndeterminate="{Binding IsActionRunning}" Visibility="{Binding IsActionRunning, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding OperationStatus}" AutomationProperties.AutomationId="ActionProgress" />
          <TextBlock Text="{Binding SelectedRepository.State}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" ToolTip="{Binding SelectedRepository.State}" Visibility="{Binding SelectedRepository.HasOperation, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Border>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button Style="{StaticResource ToolbarButton}" Command="{Binding NewBranchCommand}" ToolTip="{Binding BranchActionHelp}" AutomationProperties.HelpText="{Binding BranchActionHelp}" AutomationProperties.Name="{loc:Text Key=ActionTitleNewBranch}">
        <StackPanel><Path Style="{StaticResource ToolbarIcon}" Data="M5,2 L5,18 M5,12 C5,7 15,13 15,4 M11,4 L19,4 M15,0 L15,8"/><TextBlock Text="{loc:Text Key=BranchToolbar}"/></StackPanel>
       </Button>
       <Button Content="▾" Click="OnBranchMenu" Padding="3,6" IsEnabled="{Binding CanOpenBranchMenu}" ToolTip="{Binding BranchActionHelp}" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding BranchActionHelp}" AutomationProperties.Name="{loc:Text Key=BranchMenu}">
        <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
         <MenuItem Header="{loc:Text Key=ActionTitleNewBranch}" Command="{Binding NewBranchCommand}" ToolTip="{Binding BranchActionHelp}" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding BranchActionHelp}"/>
         <Separator/>
         <MenuItem Header="{loc:Text Key=ActionTitleSwitchBranch}" ItemsSource="{Binding BranchMenuItems}" IsEnabled="{Binding CanSwitchBranch}" ToolTip="{Binding SwitchActionHelp}" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding SwitchActionHelp}">
          <MenuItem.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Setter Property="Header" Value="{Binding Name}"/><Setter Property="Command" Value="{Binding Command}"/><Setter Property="CommandParameter" Value="{Binding Name}"/></Style></MenuItem.ItemContainerStyle>
         </MenuItem>
        </ContextMenu></Button.ContextMenu>
       </Button>
      </StackPanel></Grid>
    </Grid>
    <Grid Grid.Row="3" Background="{DynamicResource Theme.Sidebar}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="210" MinWidth="160" MaxWidth="320" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="500" />
      </Grid.ColumnDefinitions>
      <DockPanel Margin="10,14" Background="{DynamicResource Theme.Sidebar}">
        <TextBlock DockPanel.Dock="Top" Text="{Binding RepositoryTitle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="8,0,0,12" />
        <StackPanel VerticalAlignment="Top">
          <Button Content="{loc:Text Key=LocalChanges}" Command="{Binding ShowChangesCommand}" HorizontalContentAlignment="Left" Padding="8,9" Background="Transparent" BorderThickness="0" ToolTip="{loc:Text Key=CommitOpenHelp}" AutomationProperties.AutomationId="LocalChangesNavigation"/>
          <RadioButton Style="{StaticResource NavigationItem}" Content="{loc:Text Key=AllCommits}" IsChecked="{Binding IsHistory, Mode=OneWay}" Command="{Binding ShowHistoryCommand}" Padding="8,9" GroupName="Workspace" AutomationProperties.Name="{loc:Text Key=AllCommits}" AutomationProperties.AutomationId="CurrentWorkspace"/>
        </StackPanel>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns"
                    Background="{DynamicResource Theme.Border}"
                    AutomationProperties.Name="{loc:Text Key=ResizeSidebar}" AutomationProperties.AutomationId="SidebarSplitter" />
      <Grid Background="{DynamicResource Theme.Panel}" x:Name="WorkspacePanel" Visibility="{Binding IsHistory, Converter={StaticResource BoolToVisibility}}" Grid.Column="2" SizeChanged="OnWorkspaceSizeChanged">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="HistoryRow" Height="*" MinHeight="300" />
          <RowDefinition Height="5" />
          <RowDefinition x:Name="DetailsRow" Height="180" MinHeight="80" MaxHeight="360" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DataGrid Grid.Row="0" x:Name="HistoryTable" ItemsSource="{Binding Commits}" SelectedItem="{Binding SelectedCommit}"
                    Visibility="{Binding IsHistory, Converter={StaticResource BoolToVisibility}}"
                    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                    CanUserReorderColumns="False" CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                    HeadersVisibility="None" RowHeight="28" RowHeaderWidth="0" GridLinesVisibility="None" BorderThickness="1"
                    BorderBrush="{DynamicResource Theme.Border}"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="{loc:Text Key=CommitHistoryTable}" AutomationProperties.HelpText="{loc:Text Key=AllCommitsHelp}" AutomationProperties.AutomationId="CommitHistory">
            <DataGrid.Style>
              <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="Background" Value="{DynamicResource Theme.Canvas}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.HistoryText}" />
                <Setter Property="RowBackground" Value="{DynamicResource Theme.Canvas}" />
                <Style.Triggers><DataTrigger Binding="{Binding HighContrast, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                  <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                  <Setter Property="RowBackground" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger></Style.Triggers>
              </Style>
            </DataGrid.Style>
            <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityLabel}" /></Style></DataGrid.RowStyle>
            <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="AutomationProperties.HelpText" Value="{Binding Column.Header, RelativeSource={RelativeSource Self}}"/></Style></DataGrid.CellStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="{loc:Text Key=HistoryGraph}" Width="Auto" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <views:CommitGraphCell Row="{Binding Graph}" Width="{Binding DataContext.GraphWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                         IsSelected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" FlowDirection="LeftToRight" />
                </DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{loc:Text Key=HistoryDescription}" Width="*" MinWidth="300">
                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <DockPanel Margin="8,0" VerticalAlignment="Center">
                    <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Badges}" MaxWidth="210" ClipToBounds="True" ToolTip="{Binding RefLabels}" Margin="0,0,6,0">
                     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                     <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,2,4,2" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding Help}">
                      <StackPanel Orientation="Horizontal">
                       <TextBlock Text="✓" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" Margin="0,0,3,0"/>
                       <Path Data="{Binding Icon}" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Margin="0,0,4,0"/>
                       <TextBlock Text="{Binding Label}" MaxWidth="140" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                       <Path Data="{Binding RemoteIcon}" Visibility="{Binding HasRemote, Converter={StaticResource BoolToVisibility}}" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Margin="4,0,0,0"/>
                      </StackPanel>
                     </Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" Style="{StaticResource AuthorHighlightText}" />
                  </DockPanel>
                </DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="{loc:Text Key=HistoryAuthor}" Binding="{Binding Author}" Width="140" MinWidth="100" ElementStyle="{StaticResource HistoryText}" />
              <DataGridTextColumn Header="{loc:Text Key=HistoryDate}" Binding="{Binding Date}" Width="150" MinWidth="150" ElementStyle="{StaticResource HistoryText}" />
              <DataGridTextColumn Header="{loc:Text Key=HistoryHash}" Binding="{Binding ShortHash}" Width="115" MinWidth="115" ElementStyle="{StaticResource HistoryText}" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="{Binding HistoryNotice}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="450" Margin="16" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="{DynamicResource Theme.HistoryText}"/><Style.Triggers><DataTrigger Binding="{Binding Commits.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding HighContrast, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <DockPanel Grid.Row="1" Margin="8,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="{loc:Text Key=NewerShort}" Command="{Binding NewerHistoryCommand}" ToolTip="{loc:Text Key=NewerCommits}" Margin="8,0,0,0" />
              <Button Content="{loc:Text Key=OlderShort}" Command="{Binding LoadMoreHistoryCommand}" ToolTip="{loc:Text Key=LoadOlderCommits}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Left" Text="{Binding HistoryRange}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11" ToolTip="{loc:Text Key=HistoryLimits}" />
            <TextBlock Text="{Binding HistoryNotice}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11" AutomationProperties.LiveSetting="Polite">
              <TextBlock.ToolTip><StackPanel MaxWidth="460"><TextBlock Text="{Binding HistoryNotice}" TextWrapping="Wrap"/><TextBlock Text="{loc:Text Key=HistoryLimits}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></TextBlock.ToolTip>
            </TextBlock>
          </DockPanel>
        </Grid>
        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                      Background="{DynamicResource Theme.Border}"
                      AutomationProperties.Name="{loc:Text Key=ResizeDetails}" AutomationProperties.AutomationId="DetailsSplitter" />
        <TabControl SelectedIndex="{Binding DetailsIndex}" Grid.Row="2" Margin="0" AutomationProperties.Name="{loc:Text Key=Details}" AutomationProperties.AutomationId="DetailsTabs">
          <TabItem Header="{loc:Text Key=Commit}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14,10">
                <TextBlock Text="{Binding SelectedCommit.Description, TargetNullValue={loc:Text Key=SelectCommit}}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
                <TextBlock Text="{Binding SelectedCommit.RefLabels}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.Name="{loc:Text Key=CommitReferences}">
                  <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SelectedCommit.RefLabels}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{loc:Text Key=CommitMessage}" FontWeight="SemiBold" />
                <TextBox Text="{Binding SelectedCommit.MessagePreview, Mode=OneWay}" MaxHeight="220" VerticalScrollBarVisibility="Auto" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="{loc:Text Key=CommitMessage}" />
                <TextBlock Text="{Binding SelectedCommit.MessageNotice}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Text Key=HistoryAuthor}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox Text="{Binding SelectedCommit.AuthorDetails, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" AutomationProperties.Name="{loc:Text Key=HistoryAuthor}" />
                <TextBlock Text="{loc:Text Key=Committer}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox Text="{Binding SelectedCommit.CommitterDetails, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" AutomationProperties.Name="{loc:Text Key=Committer}" />
                <TextBlock Text="{loc:Text Key=HistoryHash}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox Text="{Binding SelectedCommit.Commit.Hash, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Text Key=HistoryHash}" />
                <TextBlock Text="{loc:Text Key=CommitParents}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox Text="{Binding SelectedCommit.Parents, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" FlowDirection="LeftToRight" TextWrapping="Wrap" AutomationProperties.Name="{loc:Text Key=CommitParents}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{loc:Text Key=RepositoryDetails}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="16">
                <TextBlock Text="{Binding SelectedRepository.State}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding SelectedRepository.ReadAt}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{loc:Text Key=RepositoryPath}" FontWeight="SemiBold" />
                <TextBox Text="{Binding SelectedRepository.Directory, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" FlowDirection="LeftToRight" TextWrapping="Wrap" AutomationProperties.Name="{loc:Text Key=RepositoryPath}" />
                <TextBlock Text="{loc:Text Key=WorktreePath}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox Text="{Binding SelectedRepository.Snapshot.Worktree, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" FlowDirection="LeftToRight" TextWrapping="Wrap" AutomationProperties.Name="{loc:Text Key=WorktreePath}" />
                <TextBlock Text="{loc:Text Key=CommonDirectory}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox Text="{Binding SelectedRepository.Snapshot.CommonDirectory, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" FlowDirection="LeftToRight" TextWrapping="Wrap" AutomationProperties.Name="{loc:Text Key=CommonDirectory}" />
                <TextBlock Text="{loc:Text Key=HeadCommit}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox Text="{Binding SelectedRepository.Snapshot.Commit, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" FlowDirection="LeftToRight" TextWrapping="Wrap" AutomationProperties.Name="{loc:Text Key=HeadCommit}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{loc:Text Key=Diagnostics}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
              <TextBlock Text="{Binding GitStatus}" />
              <TextBlock Text="{loc:Text Key=RawOutput}" FontWeight="SemiBold" />
              <TextBox Text="{Binding RawOutput, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Text Key=RawOutput}" />
              <TextBlock Text="{loc:Text Key=TimingNotice}" TextWrapping="Wrap" />
              <TextBox Text="{Binding TimingDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="160" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Text Key=TimingNotice}" />
            </StackPanel></ScrollViewer>
          </TabItem>
          <TabItem Header="{loc:Text Key=ActionDetailsTab}" Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" DataContext="{Binding CurrentAction}">
              <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="{Binding CurrentRepository}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentRepository}" FlowDirection="LeftToRight" />
              <TextBox Text="{Binding RawOutput, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MinHeight="60" MaxHeight="250" Margin="0,8,0,0" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Text Key=ActionOutput}" />
            </StackPanel></ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
    <Border Grid.Row="4" Padding="14,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Theme.Border}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" Margin="16,0,0,0" FlowDirection="LeftToRight" />
        <StackPanel>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="Status" />
          <TextBlock Text="{Binding SettingsNotice}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
