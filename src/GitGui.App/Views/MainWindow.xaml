<Window x:Class="GitGui.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GitGui.App.Localization"
        xmlns:views="clr-namespace:GitGui.App.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{loc:Text Key=AppTitle}" Width="1200" Height="800" MinWidth="900" MinHeight="620"
        Icon="/Shovel;component/Assets/Shovel.ico"
        WindowStartupLocation="CenterScreen" FlowDirection="{x:Static loc:UiText.Direction}"
        Background="{DynamicResource Theme.Chrome}"
        Foreground="{DynamicResource Theme.Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        AutomationProperties.AutomationId="MainWindow">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
  <Window.InputBindings>
    <KeyBinding Key="PageDown" Modifiers="Control" Command="{Binding LoadMoreHistoryCommand}" />
    <KeyBinding Key="PageUp" Modifiers="Control" Command="{Binding NewerHistoryCommand}" />
    <KeyBinding Key="T" Modifiers="Control+Alt" Command="{Binding OpenToolCommand}" CommandParameter="Bash"/>
    <KeyBinding Key="O" Modifiers="Control+Alt" Command="{Binding OpenToolCommand}" CommandParameter="Explorer"/>
  </Window.InputBindings>
  <Window.Resources>
    <ContextMenu x:Key="HistoryRowMenu" Closed="OnHistoryMenuClosed" FlowDirection="{x:Static loc:UiText.Direction}" />
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="44"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="23"/>
    </Style>
    <Style x:Key="AuthorHighlightText" TargetType="TextBlock" />
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" /><Setter Property="Padding" Value="7,4" /><Setter Property="Margin" Value="2,0" />
      <Setter Property="MinWidth" Value="48" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="ToolbarIcon" TargetType="Path">
      <Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /><Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      <Setter Property="StrokeThickness" Value="1.5" /><Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="ToolbarArrow" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
      <Setter Property="MinWidth" Value="18"/><Setter Property="Width" Value="18"/><Setter Property="Padding" Value="3,6"/><Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
    <Style x:Key="CountBadge" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Theme.Raised}"/><Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/><Setter Property="MinWidth" Value="17"/><Setter Property="Height" Value="17"/><Setter Property="Padding" Value="3,0"/>
      <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="20,-5,-4,0"/>
      <Style.Triggers><DataTrigger Binding="{Binding}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding}" Value="—"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
    </Style>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="HistoryText" TargetType="TextBlock" BasedOn="{StaticResource AuthorHighlightText}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Window.Resources>
  <Grid x:Name="ShellLayout" Background="{DynamicResource Theme.Chrome}" SizeChanged="OnWorkspaceSizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Height="32" Background="{DynamicResource Theme.Chrome}" AutomationProperties.AutomationId="IntegratedTitleBar">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" Text="{loc:Text Key=AppTitle}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource CaptionButton}" Content="─" Command="{x:Static SystemCommands.MinimizeWindowCommand}" AutomationProperties.Name="{loc:Text Key=WindowMinimize}" ToolTip="{loc:Text Key=WindowMinimize}"/>
        <Button Command="{x:Static SystemCommands.MaximizeWindowCommand}" AutomationProperties.Name="{loc:Text Key=WindowMaximizeRestore}" ToolTip="{loc:Text Key=WindowMaximizeRestore}">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Setter Property="Content" Value="□"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Content" Value="❐"/></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
        <Button Style="{StaticResource CaptionButton}" Content="×" Command="{x:Static SystemCommands.CloseWindowCommand}" AutomationProperties.Name="{loc:Text Key=WindowClose}" ToolTip="{loc:Text Key=WindowClose}"/>
      </StackPanel>
    <Menu HorizontalAlignment="Left" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{loc:Text Key=MainMenu}">
      <MenuItem Header="{loc:Text Key=FileMenu}">
        <MenuItem Header="{loc:Text Key=ActionTitleClone}" Command="{Binding CloneRepositoryCommand}" ToolTip="{Binding CloneRepositoryHelp}" ToolTipService.ShowOnDisabled="True" />
        <MenuItem Header="{loc:Text Key=NewRepository}" Command="{Binding NewRepositoryCommand}" ToolTip="{Binding NewRepositoryHelp}" ToolTipService.ShowOnDisabled="True" />
        <MenuItem Header="{loc:Text Key=OpenRepository}" Command="{Binding OpenRepositoryCommand}" />
        <MenuItem Header="{loc:Text Key=CloseTab}" Command="{Binding CloseRepositoryCommand}" />
      </MenuItem>
      <MenuItem Header="{loc:Text Key=ViewMenu}">
        <MenuItem Header="{loc:Text Key=NewerCommits}" Command="{Binding NewerHistoryCommand}" InputGestureText="{loc:Text Key=HistoryNewerShortcut}" />
        <MenuItem Header="{loc:Text Key=LoadOlderCommits}" Command="{Binding LoadMoreHistoryCommand}" InputGestureText="{loc:Text Key=HistoryOlderShortcut}" />
        <MenuItem Header="{Binding HistoryRange}" IsEnabled="False" />
        <MenuItem Header="{Binding HistoryNotice}" IsEnabled="False" />
        <MenuItem Header="{loc:Text Key=FirstHistoryPage}" Command="{Binding FirstHistoryCommand}" />

      </MenuItem>
      <MenuItem Header="{loc:Text Key=RepositoryMenu}">
        <MenuItem Header="{loc:Text Key=ActionTitleClone}" Command="{Binding CloneRepositoryCommand}" ToolTip="{Binding CloneRepositoryHelp}" ToolTipService.ShowOnDisabled="True" />
        <MenuItem Header="{loc:Text Key=RemoteManageTitle}" Command="{Binding ManageRemotesCommand}" ToolTip="{Binding ManageRemotesHelp}" ToolTipService.ShowOnDisabled="True" />
        <MenuItem Header="{loc:Text Key=RemoteAddTitle}" Command="{Binding AddRemoteCommand}" />
        <MenuItem Header="{loc:Text Key=BranchManageTitleSetUpstream}" Command="{Binding SetBranchUpstreamCommand}" />
        <MenuItem Header="{loc:Text Key=BranchManageTitleUnsetUpstream}" Command="{Binding UnsetBranchUpstreamCommand}" />
        <Separator />
        <MenuItem Header="{loc:Text Key=NewRepository}" Command="{Binding NewRepositoryCommand}" ToolTip="{Binding NewRepositoryHelp}" ToolTipService.ShowOnDisabled="True" />
        <MenuItem Header="{loc:Text Key=OpenRepository}" Command="{Binding OpenRepositoryCommand}" />
        <MenuItem Header="{loc:Text Key=RefreshRepository}" Command="{Binding RefreshRepositoryCommand}" />
        <MenuItem Header="{loc:Text Key=Stashes}" Command="{Binding StashesCommand}" />
        <MenuItem Header="{loc:Text Key=CancelOperation}" Command="{Binding CancelCommand}" />
        <MenuItem Header="{loc:Text Key=RecoveryMenu}" Visibility="{Binding HasRecovery, Converter={StaticResource BoolToVisibility}}">
          <MenuItem Header="{loc:Text Key=ActionTitleContinue}" Command="{Binding ContinueCommand}" />
          <MenuItem Header="{loc:Text Key=ActionTitleSkip}" Command="{Binding SkipCommand}" Visibility="{Binding CanSkipRecovery, Converter={StaticResource BoolToVisibility}}" />
          <MenuItem Header="{loc:Text Key=ActionTitleAbort}" Command="{Binding AbortCommand}" />
        </MenuItem>
        <MenuItem Header="{loc:Text Key=FirstHistoryPage}" Command="{Binding FirstHistoryCommand}" />
        <Separator />
        <MenuItem Header="{loc:Text Key=ChooseGit}" Command="{Binding ChooseGitCommand}" />

        <Separator />
        <MenuItem Header="{loc:Text Key=MoveLeft}" Command="{Binding MoveLeftCommand}" />
        <MenuItem Header="{loc:Text Key=MoveRight}" Command="{Binding MoveRightCommand}" />
        <MenuItem Header="{loc:Text Key=CloseTab}" Command="{Binding CloseRepositoryCommand}" />
      </MenuItem>
      <MenuItem Header="{loc:Text Key=WindowMenu}">
        <MenuItem Header="{loc:Text Key=MoveLeft}" Command="{Binding MoveLeftCommand}" />
        <MenuItem Header="{loc:Text Key=MoveRight}" Command="{Binding MoveRightCommand}" />
        <MenuItem Header="{loc:Text Key=CloseTab}" Command="{Binding CloseRepositoryCommand}" />
      </MenuItem>
      <MenuItem Header="{loc:Text Key=HelpMenu}">
        <MenuItem Header="{loc:Text Key=UpdateTitle}" Click="OnUpdates" />
        <MenuItem Header="{loc:Text Key=UpdateReadyMenu}" Click="OnUpdates" Visibility="{Binding Updates.Ready, Converter={StaticResource BoolToVisibility}}" />
        <MenuItem Header="{Binding Version}" IsEnabled="False" />

      </MenuItem>
    </Menu>
    </Grid>
    <ListBox x:Name="RepositoryTabs" Grid.Row="2" ItemsSource="{Binding Repositories}" SelectedItem="{Binding SelectedRepository}" IsEnabled="{Binding CanNavigate}"
             AllowDrop="True" PreviewMouseMove="OnTabMouseMove" PreviewMouseLeftButtonUp="OnTabMouseUp" DragOver="OnTabDragOver" Drop="OnTabDrop"
             BorderThickness="0,0,0,1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
             AutomationProperties.Name="{loc:Text Key=RepositoryTabs}" AutomationProperties.AutomationId="RepositoryTabs">
      <ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{DynamicResource Theme.TabStrip}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></ListBox.Template>
      <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Padding="6,8" ToolTip="{Binding Directory}" FlowDirection="LeftToRight" /></DataTemplate></ListBox.ItemTemplate>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
          <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
          <EventSetter Event="PreviewMouseDown" Handler="OnRepositoryTabMouseDown" />
          <Setter Property="ContextMenu">
            <Setter.Value>
              <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.Name="{loc:Text Key=RepositoryTabMenu}">
                <MenuItem Header="{loc:Text Key=RefreshRepository}" Command="{Binding RefreshTabCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Separator />
                <MenuItem Header="{loc:Text Key=MoveLeft}" Command="{Binding MoveTabLeftCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="{loc:Text Key=MoveRight}" Command="{Binding MoveTabRightCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Separator />
                <MenuItem Header="{loc:Text Key=CloseTab}" Command="{Binding CloseTabCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <MenuItem Header="{loc:Text Key=CloseOtherTabs}" Command="{Binding CloseOtherTabsCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              </ContextMenu>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
    </ListBox>
    <Grid x:Name="RepositoryToolbar" Grid.Row="1" Margin="8,4" AutomationProperties.Name="{loc:Text Key=RepositoryActions}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenRepositoryCommand}" AutomationProperties.Name="{loc:Text Key=OpenRepository}">
          <StackPanel><Path Style="{StaticResource ToolbarIcon}" Data="M1,4 L7,4 9,6 19,6 19,17 1,17 Z"/><TextBlock Text="{loc:Text Key=OpenRepository}"/></StackPanel>
        </Button>

        <Button Style="{StaticResource ToolbarButton}" Command="{Binding DefaultFetchCommand}" AutomationProperties.AutomationId="DefaultFetch" ToolTip="{Binding DefaultFetchHelp}" AutomationProperties.HelpText="{Binding DefaultFetchHelp}" AutomationProperties.Name="{loc:Text Key=Fetch}">
          <StackPanel><Path Style="{StaticResource ToolbarIcon}" Data="M10,1 L10,14 M5,9 L10,14 15,9 M2,16 L2,20 18,20 18,16"/><TextBlock Text="{loc:Text Key=Fetch}"/></StackPanel>
        </Button>
        <Button Command="{Binding FetchCommand}" Style="{StaticResource ToolbarArrow}"
                AutomationProperties.AutomationId="FetchOptions" AutomationProperties.Name="{loc:Text Key=FetchOptions}"
                ToolTip="{loc:Text Key=FetchOptions}" AutomationProperties.HelpText="{Binding FetchActionHelp}">
          <Path Data="M0,0 L6,0 3,4 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="6" Height="4" Stretch="Fill"/>
        </Button>
        <StackPanel Orientation="Horizontal" ToolTip="{Binding DivergenceHelp}">
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding DefaultPullCommand}" AutomationProperties.AutomationId="DefaultPull" AutomationProperties.Name="{loc:Text Key=Pull}" ToolTip="{Binding DefaultPullHelp}" AutomationProperties.HelpText="{Binding DefaultPullHelp}">
            <StackPanel><Grid><Path Style="{StaticResource ToolbarIcon}" Data="M17,2 C5,2 5,5 5,16 M1,11 L5,16 10,11"/><Border Style="{StaticResource CountBadge}" DataContext="{Binding PullCount}"><TextBlock Text="{Binding}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text Key=BehindCount}"/></Border></Grid><TextBlock Text="{loc:Text Key=Pull}"/></StackPanel>
          </Button>
          <Button Command="{Binding PullCommand}" Style="{StaticResource ToolbarArrow}" VerticalAlignment="Stretch"
                  AutomationProperties.AutomationId="PullOptions" AutomationProperties.Name="{loc:Text Key=PullOptions}"
                  ToolTip="{loc:Text Key=PullOptions}" AutomationProperties.HelpText="{Binding PullActionHelp}">
            <Path Data="M0,0 L6,0 3,4 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="6" Height="4" Stretch="Fill"/>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" ToolTip="{Binding DivergenceHelp}">
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding DefaultPushCommand}" AutomationProperties.AutomationId="DefaultPush" AutomationProperties.Name="{loc:Text Key=Push}" ToolTip="{Binding DefaultPushHelp}" AutomationProperties.HelpText="{Binding DefaultPushHelp}">
            <StackPanel><Grid><Path Style="{StaticResource ToolbarIcon}" Data="M3,18 C15,18 15,15 15,4 M10,9 L15,4 19,9"/><Border Style="{StaticResource CountBadge}" DataContext="{Binding PushCount}"><TextBlock Text="{Binding}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text Key=AheadCount}"/></Border></Grid><TextBlock Text="{loc:Text Key=Push}"/></StackPanel>
          </Button>
          <Button Command="{Binding PushCommand}" Style="{StaticResource ToolbarArrow}"
                  AutomationProperties.AutomationId="PushOptions" AutomationProperties.Name="{loc:Text Key=PushOptions}"
                  ToolTip="{loc:Text Key=PushOptions}" AutomationProperties.HelpText="{Binding PushActionHelp}">
            <Path Data="M0,0 L6,0 3,4 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="6" Height="4" Stretch="Fill"/>
          </Button>
        </StackPanel>
        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ShowChangesCommand}" ToolTip="{loc:Text Key=CommitOpenHelp}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding CommitButtonLabel}">
          <StackPanel><Path Style="{StaticResource ToolbarIcon}" Data="M2,10 L7,15 18,3"/><TextBlock Text="{Binding CommitButtonLabel}"/></StackPanel>
        </Button>
      </StackPanel>
      <Grid Grid.Column="1" MaxWidth="530"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border x:Name="ActivityAnchor" Margin="12,0" Padding="9,5" MaxWidth="430" Background="{DynamicResource Theme.Raised}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="17"/><RowDefinition Height="17"/><RowDefinition Height="Auto"/><RowDefinition Height="2"/></Grid.RowDefinitions>
          <Button Grid.RowSpan="2" Click="OnActivityLog" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,0,38,0" BorderThickness="0" Background="Transparent" ToolTip="{loc:Text Key=ActivityTitle}" AutomationProperties.Name="{loc:Text Key=ActivityTitle}" AutomationProperties.AutomationId="ActivityLog">
           <Grid><TextBlock Text="☰" VerticalAlignment="Center"/><StackPanel Margin="30,0,0,0">
            <TextBlock Text="{Binding RepositoryTitle}" TextAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding SelectedRepository.Head, TargetNullValue={loc:Text Key=NoRepositorySelected}}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource Theme.Muted}"/>
           </StackPanel></Grid>
          </Button>
          <StackPanel Grid.RowSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Content="⋯" Command="{Binding ShowActionDetailsCommand}" Width="19" Padding="0" Margin="0" FontSize="14" BorderThickness="0" Background="Transparent" Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" ToolTip="{loc:Text Key=ActionDetails}" AutomationProperties.Name="{loc:Text Key=ActionDetails}" />
            <Button Content="×" Command="{Binding CancelCommand}" Width="19" Padding="0" Margin="0" FontSize="14" BorderThickness="0" Background="Transparent" Visibility="{Binding IsActionRunning, Converter={StaticResource BoolToVisibility}}" ToolTip="{loc:Text Key=ActionCancelHelp}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Text Key=ActionCancel}" AutomationProperties.HelpText="{loc:Text Key=ActionCancelHelp}" />
          </StackPanel>
          <views:OperationIndicator Grid.Row="2" Activity="{Binding Activity}" Caption="{Binding OperationCaption}"/>
          <ProgressBar Grid.Row="3" Height="2" IsIndeterminate="{Binding IsActionRunning}" Visibility="{Binding IsActionRunning, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding OperationCaption}" AutomationProperties.AutomationId="ActionProgress" />
        </Grid>
      </Border>
      <Popup x:Name="ActivityPopup" PlacementTarget="{Binding ElementName=ActivityAnchor}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
       <Border Background="{DynamicResource Theme.Canvas}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="6" Padding="4">
        <views:ActivityLogView x:Name="ActivityLog" DataContext="{Binding Journal}" Width="1000" Height="480"/>
       </Border>
      </Popup>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button Style="{StaticResource ToolbarButton}" Command="{Binding NewBranchCommand}" ToolTip="{Binding BranchActionHelp}" AutomationProperties.HelpText="{Binding BranchActionHelp}" AutomationProperties.Name="{loc:Text Key=ActionTitleNewBranch}">
        <StackPanel><Path Style="{StaticResource ToolbarIcon}" Data="M5,2 L5,18 M5,12 C5,7 15,13 15,4 M11,4 L19,4 M15,0 L15,8"/><TextBlock Text="{loc:Text Key=BranchToolbar}"/></StackPanel>
       </Button>
       <Button Content="▾" Click="OnBranchMenu" Style="{StaticResource ToolbarArrow}" IsEnabled="{Binding CanOpenBranchMenu}" ToolTip="{Binding BranchActionHelp}" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding BranchActionHelp}" AutomationProperties.Name="{loc:Text Key=BranchMenu}">
        <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
         <MenuItem Header="{loc:Text Key=ActionTitleNewBranch}" Command="{Binding NewBranchCommand}" ToolTip="{Binding BranchActionHelp}" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding BranchActionHelp}"/>
         <Separator/>
         <MenuItem Header="{loc:Text Key=ActionTitleSwitchBranch}" ItemsSource="{Binding BranchMenuItems}" IsEnabled="{Binding CanSwitchBranch}" ToolTip="{Binding SwitchActionHelp}" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding SwitchActionHelp}">
          <MenuItem.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Setter Property="Header" Value="{Binding Name}"/><Setter Property="Command" Value="{Binding Command}"/><Setter Property="CommandParameter" Value="{Binding Name}"/></Style></MenuItem.ItemContainerStyle>
         </MenuItem>
         <Separator/>
         <MenuItem Header="{loc:Text Key=BranchManageTitleDeleteBranch}" Command="{Binding DeleteBranchCommand}" ToolTip="{Binding BranchManagementHelp}" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding BranchManagementHelp}"/>
         <MenuItem Header="{loc:Text Key=BranchManageTitleSetUpstream}" Command="{Binding SetBranchUpstreamCommand}" ToolTip="{Binding BranchManagementHelp}" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding BranchManagementHelp}"/>
         <MenuItem Header="{loc:Text Key=BranchManageTitleUnsetUpstream}" Command="{Binding UnsetBranchUpstreamCommand}" ToolTip="{Binding BranchManagementHelp}" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding BranchManagementHelp}"/>
        </ContextMenu></Button.ContextMenu>
       </Button>
      </StackPanel></Grid>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="{loc:Text Key=UpdateReadyShort}" Click="OnUpdates" Visibility="{Binding Updates.Ready, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Updates.Status}"/>
        <Button Style="{StaticResource ToolbarButton}" Click="OnToolbarMenu" IsEnabled="{Binding CanOpenTools}" ToolTip="{Binding WorkspaceToolsHelp}" AutomationProperties.Name="{loc:Text Key=WorkspaceOpenIn}">
          <StackPanel><Path Style="{StaticResource ToolbarIcon}" Data="M3,16 L3,10 C3,5 12,5 16,5 M12,1 L17,5 12,10"/><TextBlock Text="{loc:Text Key=WorkspaceOpenIn}"/></StackPanel>
          <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{loc:Text Key=WorkspaceBash}" Command="{Binding OpenToolCommand}" CommandParameter="Bash" InputGestureText="{loc:Text Key=WorkspaceBashShortcut}"/>
            <MenuItem Header="{loc:Text Key=WorkspaceExplorer}" Command="{Binding OpenToolCommand}" CommandParameter="Explorer" InputGestureText="{loc:Text Key=WorkspaceExplorerShortcut}"/>
            <Separator/>
            <MenuItem Header="{loc:Text Key=WorkspaceRider}" Command="{Binding OpenToolCommand}" CommandParameter="Rider" ToolTip="{loc:Text Key=WorkspaceRiderHelp}"/>
            <MenuItem Header="{loc:Text Key=WorkspaceCode}" Command="{Binding OpenToolCommand}" CommandParameter="Code"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenToolCommand}" CommandParameter="Bash" ToolTip="{Binding WorkspaceToolsHelp}" AutomationProperties.Name="{loc:Text Key=WorkspaceBash}">
          <StackPanel><Path Style="{StaticResource ToolbarIcon}" Data="M1,2 L19,2 19,18 1,18 Z M4,6 L8,10 4,14 M10,14 L15,14"/><TextBlock Text="{loc:Text Key=WorkspaceConsole}"/></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolbarButton}" Click="OnToolbarMenu" AutomationProperties.Name="{loc:Text Key=WorkspaceAppearance}" ToolTip="{loc:Text Key=WorkspaceAppearanceHelp}">
          <StackPanel><Path Style="{StaticResource ToolbarIcon}" Data="M1,2 L19,2 19,18 1,18 Z M10,2 L10,18 M4,6 L7,6 M4,10 L7,10 M4,14 L7,14"/><TextBlock Text="{loc:Text Key=WorkspaceAppearance}"/></StackPanel>
          <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{loc:Text Key=WorkspaceDark}" IsCheckable="True" IsChecked="{Binding IsDarkAppearance, Mode=OneWay}" Command="{Binding AppearanceCommand}" CommandParameter="Dark"/>
            <MenuItem Header="{loc:Text Key=WorkspaceLight}" IsCheckable="True" IsChecked="{Binding IsLightAppearance, Mode=OneWay}" Command="{Binding AppearanceCommand}" CommandParameter="Light"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="3" Background="{DynamicResource Theme.Sidebar}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="210" MinWidth="160" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="180" />
      </Grid.ColumnDefinitions>
      <DockPanel Margin="10,14" Background="{DynamicResource Theme.Sidebar}">
        <StackPanel DockPanel.Dock="Top" VerticalAlignment="Top">

          <RadioButton Style="{StaticResource NavigationItem}" Content="{loc:Text Key=AllCommits}" IsChecked="{Binding IsHistory, Mode=OneWay}" Command="{Binding ShowHistoryCommand}" Padding="8,9" GroupName="Workspace" AutomationProperties.Name="{loc:Text Key=AllCommits}" AutomationProperties.AutomationId="CurrentWorkspace"/>
          <StackPanel Margin="8,16,0,0" Visibility="{Binding HasRecovery, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="RecoveryPanel">
            <TextBlock Text="{Binding RecoveryHelp}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
            <Button Content="{loc:Text Key=ActionTitleContinue}" Command="{Binding ContinueCommand}" Margin="0,2" ToolTip="{loc:Text Key=RecoveryContinueHelp}" />
            <Button Content="{loc:Text Key=ActionTitleSkip}" Command="{Binding SkipCommand}" Margin="0,2" Visibility="{Binding CanSkipRecovery, Converter={StaticResource BoolToVisibility}}" ToolTip="{loc:Text Key=RecoverySkipHelp}" />
            <Button Content="{loc:Text Key=ActionTitleAbort}" Command="{Binding AbortCommand}" Margin="0,2" ToolTip="{loc:Text Key=RecoveryAbortHelp}" />
          </StackPanel>
        </StackPanel>
        <views:RepositorySidebarView/>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns"
                    Background="{DynamicResource Theme.Border}"
                    AutomationProperties.Name="{loc:Text Key=ResizeSidebar}" AutomationProperties.AutomationId="SidebarSplitter" />
      <Grid Background="{DynamicResource Theme.Panel}" x:Name="WorkspacePanel" Visibility="{Binding IsHistory, Converter={StaticResource BoolToVisibility}}" Grid.Column="2" SizeChanged="OnWorkspaceSizeChanged">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="HistoryRow" Height="*" MinHeight="300" />
          <RowDefinition Height="5" />
          <RowDefinition x:Name="DetailsRow" Height="180" MinHeight="80" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="2" Text="{Binding HistoryNotice}" Margin="8,4" Foreground="{DynamicResource Theme.Muted}" Visibility="{Binding ShowingStartupPreview, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
          <Border Background="{DynamicResource Theme.SequenceBackground}" BorderBrush="{DynamicResource Theme.SequenceBorder}" BorderThickness="0,0,0,1" Padding="10,6" Visibility="{Binding HasOperationBanner, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="OperationBanner">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:Text Key=ConflictResolve}" Command="{Binding ShowChangesCommand}" Margin="8,0,0,0"/>
                <Button Content="{loc:Text Key=ActionTitleContinue}" Command="{Binding ContinueCommand}" Margin="8,0,0,0"/>
                <Button Content="{loc:Text Key=ActionTitleAbort}" Command="{Binding AbortCommand}" Margin="8,0,0,0"/>
              </StackPanel>
              <TextBlock Text="{Binding OperationBanner}" Foreground="{DynamicResource Theme.Text}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
          </Border>
          <DataGrid Grid.Row="1" x:Name="HistoryTable" PreviewMouseWheel="OnHistoryWheel" ItemsSource="{Binding Commits}" SelectedItem="{Binding SelectedCommit}"
                    Visibility="{Binding IsHistory, Converter={StaticResource BoolToVisibility}}"
                    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                    CanUserReorderColumns="False" CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                    HeadersVisibility="None" RowHeight="28" RowHeaderWidth="0" GridLinesVisibility="None" BorderThickness="1"
                    BorderBrush="{DynamicResource Theme.Border}"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="{loc:Text Key=CommitHistoryTable}" AutomationProperties.HelpText="{loc:Text Key=AllCommitsHelp}" AutomationProperties.AutomationId="CommitHistory">
            <DataGrid.Style>
              <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="Background" Value="{DynamicResource Theme.Canvas}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.HistoryText}" />
                <Setter Property="RowBackground" Value="{DynamicResource Theme.Canvas}" />
                <Style.Triggers><DataTrigger Binding="{Binding HighContrast, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                  <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                  <Setter Property="RowBackground" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                </DataTrigger></Style.Triggers>
              </Style>
            </DataGrid.Style>
            <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Setter Property="ContextMenu" Value="{StaticResource HistoryRowMenu}"/>
              <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnHistoryRightDown"/>
              <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnHistorySelected"/>
              <EventSetter Event="ContextMenuOpening" Handler="OnHistoryMenuOpening"/>
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityLabel}" />
              <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsSameAuthor}" Value="True"/>
                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                <Condition Binding="{Binding HighContrast, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
              </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Theme.AuthorPeer}"/>
                <Setter Property="Foreground" Value="{DynamicResource Theme.HistoryText}"/>
              </MultiDataTrigger></Style.Triggers>
            </Style></DataGrid.RowStyle>
            <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="AutomationProperties.HelpText" Value="{Binding Column.Header, RelativeSource={RelativeSource Self}}"/></Style></DataGrid.CellStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="{loc:Text Key=HistoryGraph}" Width="Auto" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <views:CommitGraphCell Row="{Binding Graph}" Width="{Binding DataContext.GraphWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                         IsSelected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" FlowDirection="LeftToRight" />
                </DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{loc:Text Key=HistoryDescription}" Width="*" MinWidth="300">
                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <DockPanel Margin="8,0" VerticalAlignment="Center">
                    <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Badges}" MaxWidth="210" ClipToBounds="True" ToolTip="{Binding RefLabels}" Margin="0,0,6,0">
                     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                     <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,2,4,2" ToolTip="{Binding Help}" AutomationProperties.Name="{Binding Help}">
                      <StackPanel Orientation="Horizontal">
                       <TextBlock Text="✓" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" Margin="0,0,3,0"/>
                       <Path Data="{Binding Icon}" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Margin="0,0,4,0"/>
                       <TextBlock Text="{Binding Label}" MaxWidth="140" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                       <Path Data="{Binding RemoteIcon}" Visibility="{Binding HasRemote, Converter={StaticResource BoolToVisibility}}" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Margin="4,0,0,0"/>
                      </StackPanel>
                     </Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" Style="{StaticResource AuthorHighlightText}" />
                  </DockPanel>
                </DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="{loc:Text Key=HistoryAuthor}" Binding="{Binding Author}" Width="140" MinWidth="100" ElementStyle="{StaticResource HistoryText}" />
              <DataGridTextColumn Header="{loc:Text Key=HistoryDate}" Binding="{Binding Date}" Width="150" MinWidth="150" ElementStyle="{StaticResource HistoryText}" />
              <DataGridTextColumn Header="{loc:Text Key=HistoryHash}" Binding="{Binding ShortHash}" Width="115" MinWidth="115" ElementStyle="{StaticResource HistoryText}" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="1" Text="{Binding HistoryProblem}" ToolTip="{Binding RawOutput}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" MaxWidth="420" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Text="{Binding HistoryNotice}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="450" Margin="16" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="{DynamicResource Theme.HistoryText}"/><Style.Triggers><DataTrigger Binding="{Binding Commits.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding HighContrast, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>

        </Grid>
        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                      Background="{DynamicResource Theme.Border}"
                      AutomationProperties.Name="{loc:Text Key=ResizeDetails}" AutomationProperties.AutomationId="DetailsSplitter" />
        <TabControl SelectedIndex="{Binding DetailsIndex}" SelectionChanged="OnDetailsSelection" Grid.Row="2" Margin="0" AutomationProperties.Name="{loc:Text Key=Details}" AutomationProperties.AutomationId="DetailsTabs">
          <TabItem Header="{loc:Text Key=Commit}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="12,6">
                <TextBlock Text="{Binding SelectedCommit.AuthorDetails}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedCommit.RefLabels}" Foreground="{DynamicResource Theme.Muted}" TextTrimming="CharacterEllipsis"/>
                <TextBox Text="{Binding SelectedCommit.Commit.Hash, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Padding="0"/>
                <TextBox Text="{Binding SelectedCommit.MessagePreview, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Padding="0" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="70" VerticalScrollBarVisibility="Auto"/>
              </StackPanel>
              <views:CommitFilesView x:Name="HistoryFiles" DataContext="{Binding CommitFiles}"/>
            </DockPanel>
          </TabItem>
          <TabItem Header="{loc:Text Key=ChangesTab}"><views:CommitFilesView DataContext="{Binding CommitFiles}"/></TabItem>
          <TabItem Header="{loc:Text Key=ActionDetailsTab}" Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" DataContext="{Binding CurrentAction}">
              <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="{Binding CurrentRepository}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentRepository}" FlowDirection="LeftToRight" />
              <TextBox Text="{Binding RawOutput, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MinHeight="60" MaxHeight="250" Margin="0,8,0,0" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Text Key=ActionOutput}" />
            </StackPanel></ScrollViewer>
          </TabItem>

</TabControl>
      </Grid>
    </Grid>

  </Grid>
</Window>
