<Window x:Class="GitGui.App.Views.AuthenticationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GitGui.App.Localization"
        Title="{l:Text Key=AuthTitle}" Width="620" Height="480" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closed="OnClosed" FlowDirection="{x:Static l:UiText.Direction}"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        FontFamily="Segoe UI" FontSize="13">
    <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"><Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="ContextText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,12"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{l:Text Key=AuthPromptSource}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBox x:Name="PromptText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="{l:Text Key=AuthPromptSource}" Margin="0,0,0,12"/>
                <TextBlock Text="{l:Text Key=AuthSafety}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel x:Name="ResponsePanel" Grid.Row="2" Margin="0,12,0,12">
            <Label Content="{l:Text Key=AuthResponse}" Target="{Binding ElementName=Response}" Padding="0,0,0,4"/>
            <PasswordBox x:Name="Response" MaxLength="1024" Padding="5" AutomationProperties.Name="{l:Text Key=AuthResponse}"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="Submit" Content="{l:Text Key=AuthSubmit}" Click="OnSubmit" MinWidth="100" Padding="10,5" Margin="0,0,8,0"/>
            <Button x:Name="CancelPrompt" Content="{l:Text Key=AuthCancel}" IsCancel="True" IsDefault="True" Click="OnCancel" MinWidth="100" Padding="10,5"/>
        </StackPanel>
    </Grid></Border>
</Window>
