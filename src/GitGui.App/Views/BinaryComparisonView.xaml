<UserControl x:Class="GitGui.App.Views.BinaryComparisonView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GitGui.App.Localization" Foreground="{DynamicResource Theme.Text}">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <ItemsControl ItemsSource="{Binding Sides}" Margin="6,10" AutomationProperties.Name="{loc:Text Key=BinaryComparison}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate>
    <StackPanel Margin="6,0" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Accessible}">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
      <Border Background="{DynamicResource Theme.ActiveSelection}" CornerRadius="3" Padding="5,1" Margin="0,0,8,0" Visibility="{Binding IsLfs, Converter={StaticResource Visible}}"><TextBlock Text="{loc:Text Key=BinaryLfs}" Foreground="{DynamicResource Theme.SelectionText}" FontSize="11"/></Border>
      <TextBlock Text="{Binding Label}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Theme.DiffAddedText}"/><Style.Triggers><DataTrigger Binding="{Binding IsOld}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Theme.DiffRemovedText}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </StackPanel>
     <Border Width="112" Height="112" Background="{DynamicResource Theme.Raised}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="3" HorizontalAlignment="Center">
      <StackPanel VerticalAlignment="Center"><Path Data="M 0,0 L 19,0 L 29,10 L 29,38 L 0,38 Z M 19,0 L 19,10 L 29,10" Width="29" Height="38" Stretch="Uniform" Stroke="{DynamicResource Theme.Muted}" Fill="{DynamicResource Theme.Text}" StrokeThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,12"/>
       <TextBlock Text="{Binding Extension}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="4,0" ToolTip="{Binding Extension}"/>
      </StackPanel>
     </Border>
     <TextBlock Text="{Binding Size}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0"/>
    </StackPanel>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
 </ScrollViewer>
</UserControl>
