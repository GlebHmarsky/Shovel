<UserControl x:Class="GitGui.App.Views.ActivityLogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GitGui.App.Localization" Background="{DynamicResource Theme.Canvas}" Foreground="{DynamicResource Theme.Text}">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="310" MinWidth="180"/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <DockPanel>
   <TabControl DockPanel.Dock="Top" SelectedIndex="{Binding Filter}" Height="35" AutomationProperties.Name="{loc:Text Key=ActivityCategories}">
    <TabItem Header="{loc:Text Key=ActivityAll}"/><TabItem Header="{loc:Text Key=ActivityUser}"/><TabItem Header="{loc:Text Key=ActivityBackground}"/>
   </TabControl>
   <ListBox ItemsSource="{Binding Visible}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="{loc:Text Key=ActivityTitle}">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="6"/></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><Grid Margin="7,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Grid.Column="1" Text="{Binding Time}" Margin="8,0,0,0"/>
     <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Status}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Theme.Muted}"/>
    </Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel>
  <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Theme.Border}" AutomationProperties.Name="{loc:Text Key=ActivityResize}"/>
  <DockPanel Grid.Column="2" Margin="10,7">
   <TextBlock DockPanel.Dock="Top" Text="{Binding Selected.Title}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
   <TextBlock DockPanel.Dock="Top" Text="{Binding Selected.Summary}" TextWrapping="Wrap" Margin="0,0,0,7"/>
   <TextBlock DockPanel.Dock="Bottom" Text="{loc:Text Key=ActivityRetention}" FontSize="11" Foreground="{DynamicResource Theme.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <TextBox Text="{Binding Selected.Output, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="{loc:Text Key=ActionOutput}"/>
  </DockPanel>
 </Grid>
</UserControl>
