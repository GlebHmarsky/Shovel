<Window x:Class="GitGui.App.Views.ConflictWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GitGui.App.Localization"
 Title="{Binding Title}" Width="1120" Height="780" MinWidth="800" MinHeight="570" WindowStartupLocation="CenterOwner" Background="{DynamicResource Theme.Canvas}" Foreground="{DynamicResource Theme.Text}">
 <Window.Resources>
  <Style x:Key="SourceText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="IsReadOnly" Value="True"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
 </Window.Resources>
 <Grid Margin="12" Background="{DynamicResource Theme.Canvas}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding Path}" FontWeight="SemiBold" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
  <TextBlock Grid.Row="1" Text="{Binding Help}" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <DockPanel><CheckBox DockPanel.Dock="Top" IsChecked="{Binding Current}" IsEnabled="{Binding CanChoose}" Margin="0,0,0,6" ToolTip="{Binding CurrentLabel}"><TextBlock Text="{Binding CurrentLabel}" TextWrapping="Wrap"/></CheckBox><TextBox Text="{Binding CurrentText, Mode=OneWay}" Style="{StaticResource SourceText}" AutomationProperties.Name="{Binding CurrentLabel}"/></DockPanel>
   <DockPanel Grid.Column="2"><CheckBox DockPanel.Dock="Top" IsChecked="{Binding Incoming}" IsEnabled="{Binding CanChoose}" Margin="0,0,0,6" ToolTip="{Binding IncomingLabel}"><TextBlock Text="{Binding IncomingLabel}" TextWrapping="Wrap"/></CheckBox><TextBox Text="{Binding IncomingText, Mode=OneWay}" Style="{StaticResource SourceText}" AutomationProperties.Name="{Binding IncomingLabel}"/></DockPanel>
  </Grid>
  <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource Theme.Border}"/>
  <TabControl Grid.Row="4" Margin="0,6,0,0">
   <TabItem Header="{loc:Text Key=ConflictResult}"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4"><Button Content="{loc:Text Key=ConflictUseCurrent}" Command="{Binding UseCurrentTextCommand}" Margin="0,0,8,0"/><Button Content="{loc:Text Key=ConflictUseIncoming}" Command="{Binding UseIncomingTextCommand}"/></StackPanel>
    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxLength="524288" AutomationProperties.Name="{loc:Text Key=ConflictResult}"/>
   </DockPanel></TabItem>
   <TabItem Header="{loc:Text Key=ConflictBase}"><TextBox Text="{Binding BaseText, Mode=OneWay}" Style="{StaticResource SourceText}" AutomationProperties.Name="{loc:Text Key=ConflictBase}"/></TabItem>
  </TabControl>
  <StackPanel Grid.Row="5" Margin="0,8,0,8"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><Expander Header="{loc:Text Key=ActionOutput}"><TextBox Text="{Binding Output, Mode=OneWay}" Style="{StaticResource SourceText}" MaxHeight="90"/></Expander></StackPanel>
  <DockPanel Grid.Row="6"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
   <Button Content="{loc:Text Key=ConflictReload}" Command="{Binding ReloadCommand}" Margin="8,0,0,0"/><Button Content="{loc:Text Key=ConflictExternal}" Command="{Binding ExternalCommand}" Margin="8,0,0,0"/>
   <Button Content="{loc:Text Key=ActionCancel}" Command="{Binding CancelCommand}" Margin="8,0,0,0"/><Button Content="{loc:Text Key=ConflictResolveStage}" Command="{Binding ResolveCommand}" ToolTip="{Binding ResolveHelp}" ToolTipService.ShowOnDisabled="True" Margin="8,0,0,0"/>
  </StackPanel><TextBlock Text="{Binding Duration}" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
