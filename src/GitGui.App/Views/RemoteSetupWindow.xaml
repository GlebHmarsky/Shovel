<Window x:Class="GitGui.App.Views.RemoteSetupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GitGui.App.Localization" Title="{loc:Text Key=RemoteAddTitle}"
 Width="540" Height="340" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 FlowDirection="{x:Static loc:UiText.Direction}" FontFamily="Segoe UI" FontSize="13"
 Background="{DynamicResource Theme.Sidebar}" Foreground="{DynamicResource Theme.Text}">
 <Border Background="{DynamicResource Theme.Sidebar}" Padding="22"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <TextBlock Text="{loc:Text Key=RemoteAddTitle}" FontSize="22" FontWeight="SemiBold"/>
   <Label Content="{loc:Text Key=RemoteAddName}" Target="{Binding ElementName=NameInput}" Margin="0,12,0,0"/>
   <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Text Key=RemoteAddName}"/>
   <Label Content="{loc:Text Key=RemoteAddLocation}" Target="{Binding ElementName=LocationInput}" Margin="0,8,0,0"/>
   <TextBox x:Name="LocationInput" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Text Key=RemoteAddLocation}"/>
   <TextBlock Text="{Binding Readiness}" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="{loc:Text Key=RemoteAddSubmit}" Command="{Binding SubmitCommand}" IsDefault="True" MinWidth="90"/>
   <Button Content="{loc:Text Key=ActionCancel}" IsCancel="True" MinWidth="85" Margin="8,0,0,0"/>
  </StackPanel>
 </Grid></Border>
</Window>
