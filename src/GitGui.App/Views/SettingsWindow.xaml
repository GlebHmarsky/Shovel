<Window x:Class="GitGui.App.Views.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GitGui.App.Localization" Title="{loc:Text Key=SettingsTitle}"
 Width="560" Height="380" MinWidth="440" MinHeight="320" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 FlowDirection="{x:Static loc:UiText.Direction}" FontFamily="Segoe UI" FontSize="13"
 Background="{DynamicResource Theme.Sidebar}" Foreground="{DynamicResource Theme.Text}">
 <Border Background="{DynamicResource Theme.Sidebar}" Padding="22"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <TextBlock Text="{loc:Text Key=SettingsFetchTitle}" FontSize="22" FontWeight="SemiBold"/>
   <CheckBox x:Name="AutoFetchEnabledInput" Content="{loc:Text Key=SettingsFetchEnabled}" IsChecked="{Binding AutoFetchEnabled}" IsEnabled="{Binding CanEdit}" Margin="0,18,0,12" AutomationProperties.Name="{loc:Text Key=SettingsFetchEnabled}"/>
   <Label Content="{loc:Text Key=SettingsFetchInterval}" Target="{Binding ElementName=AutoFetchIntervalInput}" Padding="0,0,0,6"/>
   <TextBox x:Name="AutoFetchIntervalInput" Text="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Width="110" HorizontalAlignment="Left" MaxLength="10" AutomationProperties.Name="{loc:Text Key=SettingsFetchInterval}"/>
   <TextBlock Text="{loc:Text Key=SettingsFetchHelp}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource Theme.Muted}"/>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
   <Button Content="{loc:Text Key=SettingsSave}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="90"/>
   <Button Content="{loc:Text Key=ActionCancel}" IsCancel="True" IsEnabled="{Binding CanEdit}" MinWidth="85" Margin="8,0,0,0"/>
  </StackPanel>
 </Grid></Border>
</Window>
