<UserControl x:Class="GitGui.App.Views.CommitFilesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GitGui.App.Localization" xmlns:views="clr-namespace:GitGui.App.Views" Foreground="{DynamicResource Theme.Text}">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
 <Grid Background="{DynamicResource Theme.Canvas}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="6,3" Visibility="{Binding ShowParentSelector, Converter={StaticResource Visible}}">
   <Button DockPanel.Dock="Right" Content="{loc:Text Key=ActionCancel}" Command="{Binding CancelCommand}" Margin="6,0" IsEnabled="{Binding Busy}"/>
   <Button DockPanel.Dock="Right" Content="{loc:Text Key=CommitRefresh}" Command="{Binding RefreshCommand}"/>
   <TextBlock DockPanel.Dock="Left" Text="{loc:Text Key=CommitFilesCompare}" VerticalAlignment="Center" Margin="0,0,6,0"/>
   <ComboBox ItemsSource="{Binding Parents}" SelectedItem="{Binding Parent}" DisplayMemberPath="Label" MaxWidth="580" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Text Key=CommitFilesCompare}"/>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="FilesColumn" Width="340" MinWidth="160"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="240"/></Grid.ColumnDefinitions>
   <DataGrid ItemsSource="{Binding Files}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="None" RowHeaderWidth="0" RowHeight="24" SelectionUnit="FullRow" SelectionMode="Single" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="{loc:Text Key=CommitFilesTitle}" AutomationProperties.AutomationId="CommitFiles">
    <DataGrid.Columns>
     <DataGridTemplateColumn Width="26"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource FileChangeMarker}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Binding="{Binding Path}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding CommittedDetails}"/><Setter Property="AutomationProperties.Name" Value="{Binding CommittedDetails}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
    </DataGrid.Columns>
   </DataGrid>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Theme.Border}" AutomationProperties.Name="{loc:Text Key=CommitFilesResize}"/>
   <DockPanel Grid.Column="2">
    <CheckBox DockPanel.Dock="Top" Content="{loc:Text Key=DiffSideBySide}" IsChecked="{Binding SideBySide}" Margin="5,2"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding DisplayedPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayedPath}" Margin="5,2" FontWeight="SemiBold"/>
    <TextBlock DockPanel.Dock="Top" Text="{loc:Text Key=DiffRetainedLoading}" Visibility="{Binding Busy, Converter={StaticResource Visible}}" Foreground="{DynamicResource Theme.Muted}" TextTrimming="CharacterEllipsis" Margin="5,2"/>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource TextDiffOnly}" Text="{Binding Notice, TargetNullValue={loc:Text Key=SelectCommit}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}" Margin="5,2" Foreground="{DynamicResource Theme.Muted}" AutomationProperties.LiveSetting="Polite"/>
    <Grid>
    <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="None" RowHeaderWidth="0" RowHeight="22" SelectionUnit="FullRow" SelectionMode="Extended" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" RowStyle="{StaticResource DiffRow}" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="{loc:Text Key=DiffView}" AutomationProperties.AutomationId="CommitFileDiff">
     <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Style.Triggers><DataTrigger Binding="{Binding SideBySide}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding HasBinary}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DataGrid.Style>
     <DataGrid.Columns>
      <DataGridTextColumn Binding="{Binding OldLine}" Width="45" ElementStyle="{StaticResource DiffText}"/>
      <DataGridTextColumn Binding="{Binding NewLine}" Width="45" ElementStyle="{StaticResource DiffText}"/>
      <DataGridTextColumn Binding="{Binding Marker}" Width="24" ElementStyle="{StaticResource DiffText}"/>
      <DataGridTextColumn Binding="{Binding Text}" Width="SizeToCells" MinWidth="300" ElementStyle="{StaticResource DiffText}"/>
     </DataGrid.Columns>
    </DataGrid>
    <views:SideBySideView Rows="{Binding Lines}"><views:SideBySideView.Style><Style TargetType="views:SideBySideView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SideBySide}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding HasBinary}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></views:SideBySideView.Style></views:SideBySideView>
    <Grid Visibility="{Binding HasBinary, Converter={StaticResource Visible}}"><views:BinaryComparisonView DataContext="{Binding Binary}"/></Grid>
    </Grid>
   </DockPanel>
  </Grid>
  <StackPanel Grid.Row="2">
   <TextBlock Text="{Binding Status, TargetNullValue={loc:Text Key=SelectCommit}}" Margin="6,2" AutomationProperties.LiveSetting="Polite"/>
   <Expander Header="{loc:Text Key=ActionOutput}"><TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" MaxHeight="70" VerticalScrollBarVisibility="Auto"/></Expander>
  </StackPanel>
 </Grid>
</UserControl>
