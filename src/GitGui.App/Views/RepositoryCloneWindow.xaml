<Window x:Class="GitGui.App.Views.RepositoryCloneWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GitGui.App.Localization" Title="{loc:Text Key=ActionTitleClone}" Width="660" Height="460" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 FlowDirection="{x:Static loc:UiText.Direction}" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource Theme.Sidebar}" Foreground="{DynamicResource Theme.Text}">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="{loc:Text Key=ActionTitleClone}" FontSize="22" FontWeight="SemiBold"/>
   <Label Content="{loc:Text Key=CloneSource}" Target="{Binding ElementName=SourceInput}" Margin="0,12,0,0"/>
   <TextBox x:Name="SourceInput" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Text Key=CloneSource}"/>
   <Label Content="{loc:Text Key=CloneDirectory}" Target="{Binding ElementName=DirectoryInput}" Margin="0,8,0,0"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="{loc:Text Key=InitBrowse}" Command="{Binding BrowseCommand}" Margin="8,0,0,0"/><TextBox x:Name="DirectoryInput" Text="{Binding Directory, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Text Key=CloneDirectory}"/></DockPanel>
   <Label Content="{loc:Text Key=CloneBranch}" Target="{Binding ElementName=BranchInput}" Margin="0,8,0,0"/>
   <TextBox x:Name="BranchInput" Text="{Binding Branch, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Text Key=CloneBranch}"/>
   <TextBlock Text="{Binding Readiness}" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="{loc:Text Key=CloneSubmit}" Command="{Binding SubmitCommand}" ToolTip="{Binding Readiness}" ToolTipService.ShowOnDisabled="True" IsDefault="True" MinWidth="90"/>
   <Button Content="{loc:Text Key=ActionCancel}" IsCancel="True" Margin="8,0,0,0" MinWidth="90"/>
  </StackPanel>
 </Grid>
</Window>
