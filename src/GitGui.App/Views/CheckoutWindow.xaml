<Window x:Class="GitGui.App.Views.CheckoutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GitGui.App.Localization" Title="{Binding Title}" Width="720" MinWidth="480"
 FlowDirection="{x:Static loc:UiText.Direction}" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{DynamicResource Theme.Sidebar}" Foreground="{DynamicResource Theme.Text}" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/></Window.Resources>
 <StackPanel Margin="20">
  <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,6"/>
  <TextBlock Text="{Binding Repository}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Repository}"/>
  <TextBlock Text="{Binding Target}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12"/>
  <StackPanel Visibility="{Binding HasChanges, Converter={StaticResource Visible}}">
   <TextBlock Text="{loc:Text Key=CheckoutLocalChanges}" Margin="0,0,0,8"/>
   <RadioButton Content="{loc:Text Key=CheckoutKeep}" IsChecked="{Binding Keep}" Margin="0,4"/>
   <RadioButton Content="{loc:Text Key=CheckoutStash}" IsChecked="{Binding Stash}" Margin="0,4"/>
   <RadioButton Content="{loc:Text Key=CheckoutDiscard}" IsChecked="{Binding Discard}" Margin="0,4"/>
  </StackPanel>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12" AutomationProperties.LiveSetting="Polite"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="{Binding Title}" IsEnabled="{Binding CanConfirm}" IsDefault="True" Click="OnConfirm" Margin="0,0,8,0"/>
   <Button Content="{loc:Text Key=ActionCancel}" IsCancel="True"/>
  </StackPanel>
 </StackPanel>
</Window>
