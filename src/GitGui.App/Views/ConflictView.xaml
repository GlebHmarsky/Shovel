<UserControl x:Class="GitGui.App.Views.ConflictView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GitGui.App.Localization" Background="{DynamicResource Theme.Canvas}" Foreground="{DynamicResource Theme.Text}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style x:Key="SourceLines" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
   <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserSortColumns" Value="False"/>
   <Setter Property="HeadersVisibility" Value="None"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="RowHeight" Value="21"/>
   <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/><Setter Property="SelectionUnit" Value="FullRow"/>
   <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="8,4">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="SourcesRow" Height="55*" MinHeight="70"/><RowDefinition Height="5"/><RowDefinition x:Name="ResultRow" Height="45*" MinHeight="65"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="0,0,0,4"/>
  <StackPanel Grid.Row="1" Margin="0,0,0,4">
   <WrapPanel>
    <Button Content="{loc:Text Key=ConflictResolveStage}" Command="{Binding ResolveCommand}" ToolTip="{Binding ResolveHelp}" ToolTipService.ShowOnDisabled="True" Padding="8,3"/>
    <Button Content="{loc:Text Key=ActionCancel}" Command="{Binding CancelCommand}" Padding="8,3"/>
    <Button Content="{loc:Text Key=ConflictReload}" Command="{Binding ReloadCommand}" Padding="8,3"/>
    <Button Content="{loc:Text Key=ConflictExternal}" Command="{Binding ExternalCommand}" Padding="8,3"/>
    <ComboBox ItemsSource="{Binding Tools}" DisplayMemberPath="Label" SelectedValuePath="Name" SelectedValue="{Binding ExternalTool}" IsEnabled="{Binding CanChoose}" Width="165" Margin="4,0" AutomationProperties.Name="{loc:Text Key=ConflictToolLabel}" ToolTip="{loc:Text Key=ConflictToolHelp}" ToolTipService.ShowOnDisabled="True"/>
   </WrapPanel>
   <TextBlock Text="{Binding Help}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Help}" Foreground="{DynamicResource Theme.Muted}"/>
  </StackPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <DockPanel>
    <CheckBox DockPanel.Dock="Top" IsChecked="{Binding Current}" IsEnabled="{Binding CanChoose}" Margin="3,3,3,6" ToolTip="{Binding CurrentLabel}" AutomationProperties.Name="{Binding CurrentLabel}"><TextBlock Text="{Binding CurrentLabel}" TextTrimming="CharacterEllipsis"/></CheckBox>
    <Grid>
     <DataGrid ItemsSource="{Binding CurrentLines}" Style="{StaticResource SourceLines}" Visibility="{Binding IsText, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding CurrentLabel}">
      <DataGrid.Columns><DataGridTextColumn Binding="{Binding OldLine}" Width="42" ElementStyle="{StaticResource DiffText}"/><DataGridTextColumn Binding="{Binding Text}" Width="SizeToCells" MinWidth="200" ElementStyle="{StaticResource DiffText}"/></DataGrid.Columns>
     </DataGrid>
     <TextBlock Text="{Binding CurrentText}" TextWrapping="Wrap" Margin="8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsText}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
   </DockPanel>
   <Border Grid.Column="1" Background="{DynamicResource Theme.Border}" Width="1"/>
   <DockPanel Grid.Column="2">
    <CheckBox DockPanel.Dock="Top" IsChecked="{Binding Incoming}" IsEnabled="{Binding CanChoose}" Margin="3,3,3,6" ToolTip="{Binding IncomingLabel}" AutomationProperties.Name="{Binding IncomingLabel}"><TextBlock Text="{Binding IncomingLabel}" TextTrimming="CharacterEllipsis"/></CheckBox>
    <Grid>
     <DataGrid ItemsSource="{Binding IncomingLines}" Style="{StaticResource SourceLines}" Visibility="{Binding IsText, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding IncomingLabel}">
      <DataGrid.Columns><DataGridTextColumn Binding="{Binding NewLine}" Width="42" ElementStyle="{StaticResource DiffText}"/><DataGridTextColumn Binding="{Binding Text}" Width="SizeToCells" MinWidth="200" ElementStyle="{StaticResource DiffText}"/></DataGrid.Columns>
     </DataGrid>
     <TextBlock Text="{Binding IncomingText}" TextWrapping="Wrap" Margin="8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsText}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
   </DockPanel>
  </Grid>
  <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource Theme.Border}" DragCompleted="OnSplitCompleted" AutomationProperties.Name="{loc:Text Key=ConflictResizeResult}"/>
  <DockPanel Grid.Row="4" Visibility="{Binding IsText, Converter={StaticResource Visible}}">
   <TextBlock DockPanel.Dock="Top" Text="{Binding ResultLabel}" Margin="4" FontWeight="SemiBold"/>
   <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12" MaxLength="524288" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding ResultLabel}"/>
  </DockPanel>
  <DockPanel Grid.Row="5" Margin="0,4,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" Margin="8,0"/><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite"/></DockPanel>
 </Grid>
</UserControl>
