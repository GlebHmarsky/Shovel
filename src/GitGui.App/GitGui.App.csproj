<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Shovel</AssemblyName>
    <AssemblyTitle>Shovel</AssemblyTitle>
    <RootNamespace>GitGui.App</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Shovel.ico</ApplicationIcon>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Shovel.ico" />
    <ProjectReference Include="../GitGui.Core/GitGui.Core.csproj" />
    <ProjectReference Include="../GitGui.ProcessHost/GitGui.ProcessHost.csproj" />
    <!-- ProjectReference publishes the host EXE; this item supplies it for ordinary build/run. -->
    <None Include="../GitGui.ProcessHost/bin/$(Configuration)/net10.0-windows/GitGui.ProcessHost.exe" Link="GitGui.ProcessHost.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
